// A failing action stops Map.each at the first key it rejects in ascending key
// order: "b" is rejected before "c", though "c" went in first, and the failure
// escapes unchanged.
import std/map as Map
import std/result as Result
import std/result.{Err}
import std/test as Test

enum Rejected {
  Key(name: Text)
}

fn accept_before_b(key: Text, _value: Int) -> Void {
  case key < "b" {
    True -> Void
    False -> Failure(Rejected.Key(key))
  }
}

fn run() -> Void {
  Map.each(Map.from([("c", 3), ("a", 1), ("b", 2)]), accept_before_b)
}

test "each stops at first failure" {
  Test.assert_equal(Result.capture(run), Err(Rejected.Key("b")))
}
