// A failing change passes through Map.update unchanged, with the current value
// it was given.
import std/map as Map.{Map}
import std/result as Result.{Err}
import std/test as Test

enum Rejected {
  Current(value: Option<Int>)
}

fn reject(current: Option<Int>) -> Int {
  Failure(Rejected.Current(current))
}

fn run() -> Map<Text, Int> {
  Map.update(Map.from([("a", 1), ("b", 2)]), "b", reject)
}

test "update failure" {
  Test.assert_equal(Result.capture(run), Err(Rejected.Current(Some(2))))
}
