// A failing Int.parse is an expected failure of its source-declared
// ParseError enum.
import std/int as Int.{ParseError}
import std/result as Result.{Err}
import std/test as Test

fn run() -> Int {
  Int.parse("1 2")
}

test "parse failure escapes" {
  Test.assert_equal(Result.capture(run), Err(ParseError.InvalidDigit))
}
