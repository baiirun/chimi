// Debug.render_indented puts each field, element, and entry on its own line,
// indented by two spaces and ended with `,`; an empty list stays on one line.
// The value is the specification's example.
import std/debug as Debug
import std/test as Test

struct Money {
  cents: Int,
}

enum Status {
  Pending
  Declined(reason: Text)
}

fn run() -> Text {
  Debug.render_indented({
    items: [Money { cents: 1 }],
    status: Status.Declined("x"),
    pending: [Status.Pending],
    empty: [],
  })
}

test "render indented" {
  Test.assert_equal(run(), "{\n  empty: [],\n  items: [\n    Money {\n      cents: 1,\n    },\n  ],\n  pending: [\n    Status.Pending,\n  ],\n  status: Status.Declined(\n    \"x\",\n  ),\n}")
}
