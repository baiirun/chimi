// Text.repeat builds its result by doubling, so every bit pattern of the count
// must give exactly that many copies.
import std/list as List
import std/text as Text
import std/test as Test

test "repeat gives count copies" {
  let counts = [1, 2, 3, 4, 5, 6, 7, 8, 9]
  let lengths = List.map(counts, fn(count) { Text.byte_length(Text.repeat("é", count)) })
  Test.assert_equal(lengths, [2, 4, 6, 8, 10, 12, 14, 16, 18])
  Test.assert_equal(Text.repeat("é1", 5), "é1é1é1é1é1")
  Test.assert_equal(Text.repeat("", 1000), "")
  Test.assert_equal(Text.byte_length(Text.repeat("ab", 1000001)), 2000002)
}
