// A failing predicate stops Set.filter at the first item it rejects in
// ascending order: 5 and 8 would both fail, and 5 escapes.
import std/set as Set.{Set}
import std/result as Result.{Err}
import std/test as Test

enum Rejected {
  TooLarge(value: Int)
}

fn keep_small(value: Int) -> Bool {
  case value < 5 {
    True -> True
    False -> Failure(Rejected.TooLarge(value))
  }
}

fn run() -> Set<Int> {
  Set.filter(Set.from([8, 1, 5, 2]), keep_small)
}

test "filter failure" {
  Test.assert_equal(Result.capture(run), Err(Rejected.TooLarge(5)))
}
