// std/order: the structural Ordering, min and max, and comparators
// composed with by, reverse, and then, applied by List.sort_by.
import std/debug as Debug
import std/list as List
import std/order as Order
import std/order.{Equal, Ordering}
import std/test as Test

struct User {
  name: Text,
  age: Int,
}

struct Tagged {
  key: Int,
  tag: Text,
}

fn names(users: List<User>) -> List<Text> {
  List.map(users, fn(user) { user.name })
}

fn run() -> List<Text> {
  let users = [User { name: "cy", age: 30 }, User { name: "ada", age: 41 }, User { name: "bo", age: 30 }, User { name: "di", age: 41 }]
  let by_age = Order.by(fn(user: User) { user.age })
  let by_name = Order.by(fn(user: User) { user.name })
  let results = [
    Debug.render([Order.compare(1, 2), Order.compare("b", "a"), Order.compare(Some(1), Some(1)), Order.compare(None, Some(0))]),
    Debug.render([Order.min(Tagged { key: 2, tag: "x" }, Tagged { key: 1, tag: "y" }), Order.min(Tagged { key: 1, tag: "a" }, Tagged { key: 1, tag: "b" })]),
    Debug.render([Order.max(3, 9), Order.max(9, 3)]),
    Debug.render(names(List.sort_by(users, by_age))),
    Debug.render(names(List.sort_by(users, Order.reverse(by_age)))),
    Debug.render(names(List.sort_by(users, by_age
      |> Order.then(by_name)
    ))),
    Debug.render(names(List.sort_by(users, Order.reverse(by_age)
      |> Order.then(by_name)
    ))),
    Debug.render([Ordering.Less < Ordering.Equal, Ordering.Equal < Ordering.Greater, Order.compare(2, 2) == Equal]),
  ]
  results
}

test "comparators" {
  Test.assert_equal(run(), ["[Ordering.Less, Ordering.Greater, Ordering.Equal, Ordering.Less]", "[Tagged { key: 1, tag: \"y\" }, Tagged { key: 1, tag: \"a\" }]", "[9, 9]", "[\"cy\", \"bo\", \"ada\", \"di\"]", "[\"ada\", \"di\", \"cy\", \"bo\"]", "[\"bo\", \"cy\", \"ada\", \"di\"]", "[\"ada\", \"di\", \"bo\", \"cy\"]", "[True, True, True]"])
}
