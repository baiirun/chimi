// A defect inside Result.capture is not stored: it still ends the program.
// `divide` cannot fail, so its Result has no Err to match.
import std/result as Result
import std/result.{Ok}

fn divide(left: Int, right: Int) -> Int {
  left / right
}

pub fn main() -> Int {
  let stored = Result.capture(fn() { divide(1, 0) })
  case stored {
    Ok(value) -> value
  }
}
