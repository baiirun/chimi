// The runner closes `main`'s `environment` need with the host provider. The
// variables differ between machines, so this checks what holds on every one;
// tests/host_modules.rs sets variables and compares values.
import std/env as Env
import std/env.{Environment}
import std/map as Map
import std/path as Path

pub fn main() -> List<Bool> needs {
  environment: Environment
} {
  [
    Map.size(Env.all()) > 0,
    Path.is_absolute(Env.current_directory()),
  ]
}
