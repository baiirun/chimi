import std/debug as Debug
import std/io as IO
import std/list as List
import std/option as Option
import std/path as Path.{Path}
import std/test as Test

fn show(paths: List<Path>) -> List<Text> {
  List.map(paths, Path.to_text)
}

fn run() -> List<Text> {
  let joined = show([
    Path.join(Path.from("a"), "b"),
    Path.join(Path.from("a/"), "/b"),
    Path.join(Path.from("/"), "etc"),
    Path.join(Path.from(""), "b"),
    Path.join(Path.from(""), "/etc"),
    Path.join(Path.from("a"), ""),
  ])
  let names = [
    Path.name(Path.from("logs/app.log")),
    Path.name(Path.from("logs/")),
    Path.name(Path.from("/")),
    Path.name(Path.from("a/..")),
    Path.stem(Path.from("report.tar.gz")),
    Path.stem(Path.from(".bashrc")),
    Path.extension(Path.from("report.tar.gz")),
    Path.extension(Path.from(".bashrc")),
    Path.extension(Path.from("notes.")),
    Path.extension(Path.from("..")),
  ]
  let parents = List.map([
    Path.from("/etc/hosts"),
    Path.from("/etc"),
    Path.from("/"),
    Path.from("a"),
    Path.from("a/b/"),
    Path.from("."),
    Path.from(""),
  ], fn(path) {
    Option.map(Path.parent(path), Path.to_text)
  })
  let renamed = show([
    Path.replace_extension(Path.from("a/b.txt"), "md"),
    Path.replace_extension(Path.from("a/b"), "md"),
    Path.replace_extension(Path.from("a/b.txt"), ""),
    Path.replace_extension(Path.from("/"), "md"),
    Path.replace_extension(Path.from("b.txt/"), "md"),
    Path.replace_extension(Path.from("a/b/./"), "md"),
  ])
  let normalized = show(List.map([
    Path.from("a//b/./c/"),
    Path.from("a/../.."),
    Path.from("/../a"),
    Path.from(""),
    Path.from("./a/b/../c"),
    Path.from("/a/b/../../.."),
    Path.from("../../a"),
  ], Path.normalize))
  [
    Debug.render(joined),
    Debug.render(names),
    Debug.render(parents),
    Debug.render(renamed),
    Debug.render(normalized),
    Debug.render([Path.parts(Path.from("/usr//./bin")), Path.parts(Path.from("."))]),
    Debug.render([Path.is_absolute(Path.from("/a")), Path.is_absolute(Path.from("a"))]),
    Debug.render([Path.from("a") == Path.from("a"), Path.from("a/") == Path.from("a")]),
    // std/io's `Path` is this module's.
    Path.to_text(Path.join(IO.path("logs"), "app.log")),
  ]
}

test "lexical" {
  Test.assert_equal(run(), ["[\"a/b\", \"a/b\", \"/etc\", \"b\", \"etc\", \"a\"]", "[Some(\"app.log\"), Some(\"logs\"), None, None, Some(\"report.tar\"), Some(\".bashrc\"), Some(\"gz\"), None, None, None]", "[Some(\"/etc\"), Some(\"/\"), None, Some(\".\"), Some(\"a\"), None, None]", "[\"a/b.md\", \"a/b.md\", \"a/b\", \"/\", \"b.md\", \"a/b.md\"]", "[\"a/b/c\", \"..\", \"/a\", \".\", \"a/c\", \"/\", \"../../a\"]", "[[\"/\", \"usr\", \"bin\"], []]", "[True, False]", "[True, False]", "logs/app.log"])
}
