import std/cli as Cli.{Parsed}
import std/option as Option.{None, Option, Some}
import std/test as Test

const all = Cli.flag("all", "a", "Include hidden items")

fn chosen(sub: Option<Parsed>) -> Parsed {
  case sub {
    Some(parsed) -> parsed
    None -> Test.fail("expected the subcommand to be chosen")
  }
}

test "subcommands nest" {
  let deep = Cli.subcommand(Cli.command("deep", "Go deeper", [Cli.arg(all)]))
  let middle = Cli.subcommand(Cli.command("middle", "In between", [Cli.arg(deep)]))
  let top = Cli.command("top", "At the top", [Cli.arg(middle)])
  let inner = chosen(Cli.get(chosen(Cli.get(Cli.parse(top, ["middle", "deep", "-a"]), middle)), deep))
  Test.assert_equal(Cli.get(inner, all), True)
}
