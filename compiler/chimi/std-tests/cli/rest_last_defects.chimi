import std/cli as Cli
import std/test as Test

const verbose = Cli.flag("verbose", "v", "Say more")
const quiet = Cli.flag("quiet", "q", "Say less")
const name = Cli.argument("name", "Who", Cli.text)
const files = Cli.rest("file", "Files to read", Cli.path)

test "a rest must be the last positional" {
  let message = Test.capture_defect(fn() {
    Cli.command("t", "", [Cli.arg(files), Cli.arg(name)])
  })
  Test.assert_equal(message, "Cli.command: t declares an argument after its rest")
  let accepted = Cli.command("t", "", [Cli.arg(name), Cli.arg(verbose), Cli.arg(files), Cli.arg(quiet)])
  Test.assert_equal(Cli.get(Cli.parse(accepted, ["x", "y", "-q"]), quiet), True)
}
