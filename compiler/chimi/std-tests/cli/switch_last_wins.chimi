import std/cli as Cli
import std/test as Test

const color = Cli.switch("color", "c", "Color the output", True)
const pager = Cli.switch("pager", "", "Page long output", False)
const quiet = Cli.flag("quiet", "q", "Say less")
const tool = Cli.command("tool", "A tool", [Cli.arg(color), Cli.arg(pager), Cli.arg(quiet)])

test "--long turns a switch on, --no-long off, and the last one wins" {
  Test.assert_equal(Cli.get(Cli.parse(tool, ["--no-color"]), color), False)
  Test.assert_equal(Cli.get(Cli.parse(tool, ["--pager"]), pager), True)
  Test.assert_equal(Cli.get(Cli.parse(tool, ["--no-color", "--color"]), color), True)
  Test.assert_equal(Cli.get(Cli.parse(tool, ["--color", "--no-color"]), color), False)
  Test.assert_equal(Cli.get(Cli.parse(tool, ["--no-color", "-qc"]), color), True)
}
