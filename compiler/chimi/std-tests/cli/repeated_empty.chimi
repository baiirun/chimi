import std/cli as Cli
import std/test as Test

const include = Cli.repeated("include", "I", "Add a search directory", Cli.path)
const level = Cli.repeated("level", "l", "A level", Cli.int)
const tool = Cli.command("tool", "A tool", [Cli.arg(include), Cli.arg(level)])

test "a repeated option not given is an empty list" {
  Test.assert_equal(Cli.get(Cli.parse(tool, []), level), [])
}
