import std/cli as Cli
import std/test as Test
import std/text as Text

const verbose = Cli.flag("verbose", "v", "Say more")
const quiet = Cli.flag("quiet", "q", "Say less")
const max = Cli.option("max", "m", "Stop after N", Cli.int)
const output = Cli.option("output", "", "Where to write", Cli.path)
const name = Cli.argument("name", "Who", Cli.text)
const files = Cli.rest("file", "Files to read", Cli.path)
const tool = Cli.command("tool", "A tool", [Cli.arg(verbose), Cli.arg(quiet), Cli.arg(max), Cli.arg(output), Cli.arg(name), Cli.arg(files)])

test "usage lists arguments, then options with the built-in ones last" {
  let expected = Text.join([
    "A tool",
    "",
    "usage: tool [options] <name> [<file>...]",
    "",
    "Arguments:",
    "  <name>       Who",
    "  [<file>...]  Files to read",
    "",
    "Options:",
    "  -v, --verbose        Say more",
    "  -q, --quiet          Say less",
    "  -m, --max <int>      Stop after N",
    "      --output <path>  Where to write",
    "  -h, --help           Print this help",
  ], "\n")
  Test.assert_equal(Cli.usage(tool), expected)
}
