import std/cli as Cli
import std/test as Test

const item = Cli.argument("item", "What to add", Cli.text)
const add = Cli.subcommand(Cli.command("add", "Add an item", []))

test "a command with both positionals and subcommands defects" {
  let mixed = Test.capture_defect(fn() {
    Cli.command("t", "", [Cli.arg(item), Cli.arg(add)])
  })
  Test.assert_equal(mixed, "Cli.command: t declares both positional arguments and subcommands")
}
