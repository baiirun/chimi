import std/cli as Cli.{Parsed}
import std/option as Option.{None, Option, Some}
import std/test as Test

const verbose = Cli.flag("verbose", "v", "Say more")
const all = Cli.flag("all", "a", "Include hidden items")
const list = Cli.subcommand(Cli.command("list", "List the items", [Cli.arg(all)]))
const item = Cli.argument("item", "What to add", Cli.text)
const add = Cli.subcommand(Cli.command("add", "Add an item", [Cli.arg(verbose), Cli.arg(item)]))
const tool = Cli.command("tool", "Keep a list", [Cli.arg(verbose), Cli.arg(list), Cli.arg(add)])

fn chosen(sub: Option<Parsed>) -> Parsed {
  case sub {
    Some(parsed) -> parsed
    None -> Test.fail("expected the subcommand to be chosen")
  }
}

test "a subcommand chosen with no words of its own is still Some" {
  let parsed = Cli.parse(tool, ["list"])
  Test.assert_equal(Cli.get(chosen(Cli.get(parsed, list)), all), False)
  Test.assert_equal(Option.is_some(Cli.get(parsed, add)), False)
}
