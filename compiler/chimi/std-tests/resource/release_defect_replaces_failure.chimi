// A defect in `release` replaces the failure `use` ended with.
import std/resource as Resource
import std/test as Test

enum UseError {
  Broken
}

fn divide(left: Int, right: Int) -> Int {
  left / right
}

fn run() -> Int {
  Resource.scoped(
    fn() { 0 },
    fn(held) {
      let _ = divide(2, held)
      Void
    },
    fn(_held) { Failure(UseError.Broken) },
  )
}

test "release defect replaces failure" {
  Test.assert_equal(Test.capture_defect(run), "integer division by zero in `/`: 2 / 0")
}
