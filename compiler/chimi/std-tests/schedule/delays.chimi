// Schedule.delay gives the wait before the try after `attempt`, and None once
// the attempts are used up. Exponential waits double up to the limit and stay
// there; a first wait above the limit waits the limit; a huge attempt number
// at the largest limit stops doubling instead of overflowing, and a zero first
// wait answers at once.
import std/debug as Debug
import std/duration as Duration
import std/schedule as Schedule
import std/test as Test

fn run() -> Text {
  let ms = fn(count) { Duration.milliseconds(count) }
  let immediate = Schedule.immediate(2)
  let fixed = Schedule.fixed(3, Duration.seconds(1))
  let growing = Schedule.exponential(6, ms(100), ms(500))
  let capped = Schedule.exponential(3, Duration.seconds(9), Duration.seconds(2))
  let huge = Schedule.exponential(
    9000000000000000000,
    Duration.nanoseconds(3),
    Duration.nanoseconds(9223372036854775807),
  )
  let zero = Schedule.exponential(9000000000000000000, Duration.zero, Duration.seconds(1))
  Debug.render([
    [Schedule.delay(immediate, 1), Schedule.delay(immediate, 2)],
    [Schedule.delay(fixed, 1), Schedule.delay(fixed, 2), Schedule.delay(fixed, 3)],
    [
      Schedule.delay(growing, 1),
      Schedule.delay(growing, 2),
      Schedule.delay(growing, 3),
      Schedule.delay(growing, 4),
      Schedule.delay(growing, 5),
      Schedule.delay(growing, 6),
    ],
    [Schedule.delay(capped, 1), Schedule.delay(capped, 2), Schedule.delay(capped, 3)],
    [Schedule.delay(huge, 62), Schedule.delay(huge, 63), Schedule.delay(huge, 8999999999999999999)],
    [Schedule.delay(zero, 8999999999999999999)],
  ])
}

test "delays" {
  Test.assert_equal(run(), "[[Some(0s), None], [Some(1s), Some(1s), None], [Some(100ms), Some(200ms), Some(400ms), Some(500ms), Some(500ms), None], [Some(2s), Some(2s), None], [Some(1921535h50m27.641081856s), Some(2562047h47m16.854775807s), Some(2562047h47m16.854775807s)], [Some(0s)]]")
}
