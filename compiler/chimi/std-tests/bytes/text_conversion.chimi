// Bytes.to_text and to_text_lossy: a round trip through from_text, the offset
// of the first invalid sequence, and one U+FFFD per maximal invalid subpart
// (truncated, overlong, surrogate, past U+10FFFF, and stray bytes).
import std/bytes as Bytes.{Bytes, DecodeError}
import std/debug as Debug
import std/list as List
import std/test as Test

fn strict(bytes: Bytes) -> Text {
  case Bytes.to_text(bytes) {
    Success(text) -> Debug.render(text)
    Failure(DecodeError.InvalidUtf8(at)) -> "InvalidUtf8 at ${at}"
  }
}

fn run() -> List<Text> {
  let samples = [
    Bytes.from_text("héllo €😀"),
    Bytes.from([0]),
    Bytes.from([0x61, 0xff, 0x62]),
    Bytes.from([0x61, 0x62, 0xe2, 0x82]),
    Bytes.from([0xe0, 0x80, 0x80]),
    Bytes.from([0xed, 0xa0, 0x80]),
    Bytes.from([0xf0, 0x9f, 0x98, 0x41]),
    Bytes.from([0xf4, 0x90, 0x80, 0x80]),
    Bytes.from([0xc0, 0xaf]),
    Bytes.from([0xe2, 0x82, 0xac, 0x80]),
    Bytes.empty(),
  ]
  let results = [
    Debug.render(List.map(samples, strict)),
    Debug.render(List.map(samples, Bytes.to_text_lossy)),
    Debug.render(Bytes.to_text(Bytes.from_text("round trip ✓")) == "round trip ✓"),
  ]
  results
}

test "text conversion" {
  Test.assert_equal(run(), ["[\"\\\"héllo €😀\\\"\", \"\\\"\\\\u{0}\\\"\", \"InvalidUtf8 at 1\", \"InvalidUtf8 at 2\", \"InvalidUtf8 at 0\", \"InvalidUtf8 at 0\", \"InvalidUtf8 at 0\", \"InvalidUtf8 at 0\", \"InvalidUtf8 at 0\", \"InvalidUtf8 at 3\", \"\\\"\\\"\"]", "[\"héllo €😀\", \"\\u{0}\", \"a�b\", \"ab�\", \"���\", \"���\", \"�A\", \"����\", \"��\", \"€�\", \"\"]", "True"])
}
