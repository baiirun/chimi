// Json.decode rejects malformed text, trailing input, a duplicate member name
// (never choosing one), invalid numbers and escapes, and nesting past 128
// levels, each with the same message and byte offset on both backends.
import std/debug as Debug
import std/json as Json.{DecodeError}
import std/text as Text
import std/test as Test

fn decoded(text: Text) -> Text {
  case Json.decode(text) {
    Success(value) -> Text.append("ok ", Json.encode(value))
    Failure(DecodeError.InvalidJson(message, offset)) -> "${message} at ${Debug.render(offset)}"
  }
}

fn nested(depth: Int) -> Text {
  let opening = loop (count, text) = (0, "") {
    case count == depth {
      True -> break text
      False -> (count + 1, Text.append(text, "["))
    }
  }
  let closing = loop (count, text) = (0, "") {
    case count == depth {
      True -> break text
      False -> (count + 1, Text.append(text, "]"))
    }
  }
  "${opening}0${closing}"
}

fn run() -> List<Text> {
  [
    decoded(""),
    decoded("   "),
    decoded("{"),
    decoded("[1,]"),
    decoded("{\"a\" 1}"),
    decoded("{\"a\": 1, \"a\": 1}"),
    decoded("{\"b\": {\"a\": 1, \"a\": 2}}"),
    decoded("1 2"),
    decoded("01"),
    decoded("1."),
    decoded("-"),
    decoded("1e+"),
    decoded("+1"),
    decoded("NaN"),
    decoded("tru"),
    decoded("\"\\x\""),
    decoded("\"\\ud83d\""),
    decoded("\"open"),
    decoded("\"a\u{1}b\""),
    decoded("{1: 2}"),
    Debug.render(Text.starts_with(decoded(nested(128)), "ok [[[")),
    decoded(nested(129)),
  ]
}

test "invalid json" {
  Test.assert_equal(run(), ["expected a JSON value at 0", "expected a JSON value at 3", "expected a string key in JSON object at 1", "expected a JSON value at 3", "expected `:` after JSON object key at 5", "duplicate JSON object key `a` at 9", "duplicate JSON object key `a` at 15", "unexpected characters after JSON value at 2", "JSON numbers cannot contain leading zeroes at 1", "expected digits after JSON decimal point at 2", "expected digits in JSON number at 1", "expected digits in JSON exponent at 3", "expected a JSON value at 0", "expected a JSON value at 0", "invalid JSON literal at 0", "invalid JSON escape at 3", "high surrogate must be followed by a low surrogate at 7", "unterminated JSON string at 5", "unescaped control character in JSON string at 2", "expected a string key in JSON object at 1", "True", "JSON nesting exceeds the configured limit at 129"])
}
