// A failing callback stops List.map at that element: the failure escapes with
// the first failing element, and later elements are never visited.
import std/list as List

enum Rejected {
  Odd(value: Int)
}

fn even(value: Int) -> Int {
  case value % 2 {
    0 -> value
    _ -> Failure(Rejected.Odd(value))
  }
}

pub fn main() -> List<Int> {
  List.map([2, 4, 5, 6, 7], even)
}
