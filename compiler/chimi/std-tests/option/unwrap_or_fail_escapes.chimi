// An absent value raised through Option.unwrap_or_fail is the program's
// expected failure, with the caller's own payload.
import std/option as Option
import std/result as Result.{Err}
import std/test as Test

enum Lookup {
  Missing(id: Int)
}

fn run() -> Int {
  Option.unwrap_or_fail(None, Lookup.Missing(42))
}

test "unwrap or fail escapes" {
  Test.assert_equal(Result.capture(run), Err(Lookup.Missing(42)))
}
