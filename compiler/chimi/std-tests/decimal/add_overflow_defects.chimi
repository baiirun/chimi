// A sum past 38 digits defects like Int overflow.
import std/decimal as Decimal.{Decimal}
import std/test as Test

fn run() -> Decimal {
  let almost = Decimal.of(9223372036854775807, 0) * Decimal.of(9223372036854775807, 0)
  almost + almost
}

test "add overflow defects" {
  Test.assert_equal(Test.capture_defect(run), "decimal overflow in `+`: 85070591730234615847396907784232501249 + 85070591730234615847396907784232501249 needs more than 38 digits or scale 38")
}
