// Decimal.of takes scales 0 through 38; any other is a broken precondition.
import std/decimal as Decimal.{Decimal}
import std/test as Test

fn run() -> Decimal {
  Decimal.of(1, 39)
}

test "of scale outside defects" {
  Test.assert_equal(Test.capture_defect(run), "Decimal.of: scale must be in 0..=38, got 39")
}
