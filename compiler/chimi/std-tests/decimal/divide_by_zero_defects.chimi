// N27: division by zero is a broken precondition, whatever the zero's scale.
import std/decimal as Decimal
import std/decimal.{Decimal, Rounding}
import std/test as Test

fn run() -> Decimal {
  let one = Decimal.of(1, 0)
  let zero = Decimal.of(0, 2)
  Decimal.divide(one, zero, 2, Rounding.HalfEven)
}

test "divide by zero defects" {
  Test.assert_equal(Test.capture_defect(run), "Decimal.divide: divisor must not be zero")
}
