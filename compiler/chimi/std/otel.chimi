/// OpenTelemetry export: what a run records, in the OTLP/JSON encoding a
/// collector takes at `/v1/metrics`.
///
/// `Otel.metrics_request` turns a `chimi.metrics.v1` document, the runner's
/// aggregate (observability.md, "The runner's aggregate"), into the body of
/// an OTLP `ExportMetricsServiceRequest`. It is what
/// `chimi metrics export --otlp` writes, apart from the scope's version:
///
/// ```text
/// let body = Otel.metrics_request(document, "checkout")
/// ```
///
/// Each name is one metric, and each of its label sets is one data point,
/// cumulative from the run's start. A count is a monotonic sum, a gauge is a
/// gauge, and an observation is an explicit-bucket histogram with the
/// document's bounds. Dropped label sets and kind conflicts are counts named
/// `chimi.metrics.dropped_label_sets` and `chimi.metrics.dropped_kind_conflicts`,
/// written only when not zero.

import std/bytes as Bytes
import std/clock as Clock.{Clock}
import std/duration as Duration.{Duration}
import std/http as Http
import std/json as Json.{Number, Value}
import std/list as List
import std/map as Map.{Map}
import std/metrics as Metrics.{Metrics}
import std/net as Net.{Network}
import std/option as Option.{None, Option, Some}
import std/resource as Resource
import std/result as Result.{Err, Ok}
import std/task as Task
import std/text as Text

// 1. Public types.

/// Where and how often `Otel.export` pushes, the type of `Otel.defaults`.
/// `endpoint` is the collector's OTLP/HTTP base URL; metrics go to
/// `<endpoint>/v1/metrics`. `headers` are sent with every push, such as an
/// API key. `timeout` bounds one push, and `flush_within` the last one,
/// when the body ends. `client` is the HTTP client's settings, such as its
/// roots for `https`.
pub type Settings = { endpoint: Text, service_name: Text, interval: Duration, timeout: Duration, flush_within: Duration, headers: List<(Text, Text)>, client: Http.ClientSettings }

/// The defaults, to update with what differs:
/// `{ ..Otel.defaults, endpoint: "http://collector:4318", service_name: "checkout" }`.
/// They push to a collector on this machine every 10 s, give a push 5 s
/// and the last push 5 s, and name the service `unknown_service`, as
/// OpenTelemetry names an unnamed one.
pub const defaults: Settings = {
  endpoint: "http://localhost:4318",
  service_name: "unknown_service",
  interval: Duration.seconds(10),
  timeout: Duration.seconds(5),
  flush_within: Duration.seconds(5),
  headers: [],
  client: Http.client_defaults,
}

/// A running export, which `Otel.export` passes to its body.
pub struct Exporter {
  settings: Settings,
}

// 2. Failure types.

/// Failures of reading a metrics document.
pub enum DocumentError {
  /// The text is not a `chimi.metrics.v1` document this module can read;
  /// `message` says what is wrong.
  Invalid(message: Text)
}

// 7. Conversions.

/// The OTLP/JSON body for the metrics document `document`, with its resource
/// named `service_name`.
///
/// Fails with: `DocumentError.Invalid` when `document` is not a
/// `chimi.metrics.v1` document, with the reason `chimi metrics export --otlp`
/// gives.
///
/// Cost: O(n log n) in the size of the document.
pub fn metrics_request(document: Text, service_name: Text) -> Text {
  let fields = case Json.decode(document) {
    Success(Value.Object(fields)) -> fields
    Success(_) -> Failure(DocumentError.Invalid("not a JSON object"))
    Failure(_) -> Failure(DocumentError.Invalid("not a JSON document"))
  }
  case Map.get(fields, "schema") {
    Some(Value.Text("chimi.metrics.v1")) -> Void
    _ -> Failure(DocumentError.Invalid("not a chimi.metrics.v1 document"))
  }
  let times = Times {
    start: time(fields, "start_unix_ns"),
    end: time(fields, "time_unix_ns"),
  }
  let entries = case Map.get(fields, "metrics") {
    Some(Value.Array(entries)) -> entries
    _ -> Failure(DocumentError.Invalid("the document has no metrics list"))
  }
  let series = List.map(List.enumerate(entries), fn(entry) {
    let (index, value) = entry
    case value {
      Value.Object(_) -> Option.unwrap_or_fail(read_series(value), DocumentError.Invalid("metric ${index} is not a count, gauge or observation"))
      _ -> Failure(DocumentError.Invalid("metric ${index} is not an object"))
    }
  })
  let metrics = List.append(List.map(groups(series), fn(group) { metric(group, times) }), dropped(fields, times))
  Json.encode(object([
    ("resourceMetrics", Json.array([object([
      ("resource", object([("attributes", Json.array([attribute("service.name", service_name)]))])),
      ("scopeMetrics", Json.array([object([
        ("scope", object([("name", Json.text("chimi"))])),
        ("metrics", Json.array(metrics)),
      ])])),
    ])])),
  ]))
}

// 6. Exporting.

/// Runs `body` while the runner's metrics are pushed to the collector that
/// `settings` names, and returns what `body` returns. Metrics are pushed
/// every `settings.interval`, and once more when `body` ends, however it
/// ends: returns, fails, defects or is stopped, as on `SIGTERM`.
///
/// ```text
/// pub fn main() -> Void needs { network: Network, clock: Clock, metrics: Metrics } {
///   let settings = { ..Otel.defaults, endpoint: "http://collector:4318", service_name: "checkout" }
///   Otel.export(settings, fn(_) { serve() })
/// }
/// ```
///
/// What is pushed is what the runner's `metrics` provider records,
/// cumulative from the run's start: the first thing `export` does is read
/// the aggregate, which turns recording on (`Metrics.runner_document`), so
/// call it first in `main`. A push that fails (the collector is down,
/// slow, or answers other than 2xx) is dropped and counted as
/// `chimi.otel.failed_exports`; the next push carries the totals, so a
/// collector that comes back sees every count. A push never fails `body`.
///
/// Fails with: what `body` fails with.
/// Defects when: `settings.interval`, `timeout` or `flush_within` is not
/// positive.
pub fn export<T, E, R>(settings: Settings, body: fn(Exporter) -> T errors E needs R) -> T needs R + {
  network: Network,
  clock: Clock,
  metrics: Metrics
} {
  let _ = Metrics.runner_document()
  let exporter = Exporter { settings: settings }
  Resource.scoped(fn() {
    Task.start(fn() { push_every(settings) })
  }, fn(pushing) {
    Task.cancel(pushing)
    push_within(settings, settings.flush_within)
  }, fn(_) { body(exporter) })
}

// 8. Private helpers.

fn push_every(settings: Settings) -> Void needs {
  network: Network,
  clock: Clock,
  metrics: Metrics
} {
  loop _pushed = Void {
    Clock.sleep(settings.interval)
    push_within(settings, settings.timeout)
  }
}

// One push of the aggregate as it stands, given at most `limit`. A failed
// push is counted, never raised.
fn push_within(settings: Settings, limit: Duration) -> Void needs {
  network: Network,
  clock: Clock,
  metrics: Metrics
} {
  let pushed = Result.capture(fn() {
    Task.timeout(fn() {
      let body = metrics_request(Metrics.runner_document(), settings.service_name)
      let headers = List.append([("content-type", "application/json")], settings.headers)
      let reply = Http.send(Http.Method.Post, "${settings.endpoint}/v1/metrics", headers, Bytes.from_text(body), { ..settings.client, timeout: limit })
      let status = Http.status(reply)
      status >= 200 and status < 300
    }, limit)
  })
  case pushed {
    Ok(True) -> Void
    _ -> Metrics.count("chimi.otel.failed_exports", 1, [])
  }
}

// AGGREGATION_TEMPORALITY_CUMULATIVE.
const cumulative = 2

struct Times {
  start: Text,
  end: Text,
}

enum Kind {
  Count
  Gauge
  Observe
}

// One label set of one name, with the numbers as the document spells them.
struct Series {
  name: Text,
  labels: List<(Text, Text)>,
  kind: Kind,
  // A count's or gauge's value.
  value: Value,
  // An observation's count, sum, bounds and bucket counts.
  histogram: Option<Histogram>,
}

struct Histogram {
  count: Value,
  sum: Value,
  bounds: List<Value>,
  buckets: List<Value>,
}

// OTLP times are unsigned nanoseconds since 1970, written as decimal text.
fn time(fields: Map<Text, Value>, key: Text) -> Text {
  let missing = DocumentError.Invalid("the document has no ${key}; it was written by a runtime without run times")
  case Map.get(fields, key) {
    Some(Value.Number(number)) -> {
      let digits = spelling(number)
      case (Text.starts_with(digits, "-"), is_unsigned(digits)) {
        (True, _) -> Failure(DocumentError.Invalid("the document's ${key} is before 1970, which OpenTelemetry cannot carry"))
        (False, True) -> digits
        (False, False) -> Failure(missing)
      }
    }
    _ -> Failure(missing)
  }
}

// Whether a JSON number's spelling is a whole number from 0 to 2^64 - 1,
// which is what an OTLP unsigned 64-bit field holds. A valid JSON number
// without a sign, fraction or exponent is decimal digits with no leading
// zero, so comparing equal-length spellings compares the numbers.
fn is_unsigned(digits: Text) -> Bool {
  let whole = not List.any(["-", ".", "e", "E"], fn(mark) { Text.contains(digits, mark) })
  let length = Text.byte_length(digits)
  whole and (length < 20 or (length == 20 and digits <= "18446744073709551615"))
}

fn read_series(value: Value) -> Option<Series> {
  case value {
    Value.Object(fields) -> case (Map.get(fields, "name"), Map.get(fields, "labels"), Map.get(fields, "kind")) {
      (Some(Value.Text(name)), Some(Value.Object(labels)), Some(Value.Text(kind))) -> {
        let pairs = List.map(Map.entries(labels), fn(label) {
          let (key, value) = label
          case value {
            Value.Text(text) -> Some((key, text))
            _ -> None
          }
        })
        case List.all(pairs, Option.is_some) {
          False -> None
          True -> {
            let labels = List.filter_map(pairs, fn(pair) { pair })
            case kind {
              "count" -> numeric(fields, "value", fn(value) {
                simple(name, labels, Kind.Count, value)
              })
              "gauge" -> numeric(fields, "value", fn(value) {
                simple(name, labels, Kind.Gauge, value)
              })
              "observe" -> observation(fields, name, labels)
              _ -> None
            }
          }
        }
      }
      _ -> None
    }
    _ -> None
  }
}

fn simple(name: Text, labels: List<(Text, Text)>, kind: Kind, value: Value) -> Series {
  Series {
    name: name, labels: labels, kind: kind, value: value, histogram: None
  }
}

fn numeric(fields: Map<Text, Value>, key: Text, build: fn(Value) -> Series) -> Option<Series> {
  case Map.get(fields, key) {
    Some(Value.Number(number)) -> Some(build(Value.Number(number)))
    _ -> None
  }
}

fn numbers(value: Option<Value>) -> Option<List<Value>> {
  case value {
    Some(Value.Array(items)) -> case List.all(items, is_number) {
      True -> Some(items)
      False -> None
    }
    _ -> None
  }
}

fn is_number(value: Value) -> Bool {
  case value {
    Value.Number(_) -> True
    _ -> False
  }
}

fn observation(fields: Map<Text, Value>, name: Text, labels: List<(Text, Text)>) -> Option<Series> {
  case (Map.get(fields, "count"), Map.get(fields, "sum"), numbers(Map.get(fields, "bounds")), numbers(Map.get(fields, "bucket_counts"))) {
    (Some(Value.Number(count)), Some(Value.Number(sum)), Some(bounds), Some(buckets)) -> case List.length(buckets) == List.length(bounds) + 1 {
      True -> Some(Series {
        name: name,
        labels: labels,
        kind: Kind.Observe,
        value: Value.Null,
        histogram: Some(Histogram {
          count: Value.Number(count), sum: Value.Number(sum), bounds: bounds, buckets: buckets
        }),
      })
      False -> None
    }
    _ -> None
  }
}

// The document's series are ordered by name, so one name's label sets are
// adjacent; a name and kind start a new group when either changes.
fn groups(series: List<Series>) -> List<List<Series>> {
  List.reduce(series, [], fn(done, next) {
    let last = List.length(done) - 1
    case List.get(done, last) {
      Some(group) -> case List.first(group) {
        Some(first) -> case first.name == next.name and first.kind == next.kind {
          True -> List.set(done, last, List.push(group, next))
          False -> List.push(done, [next])
        }
        None -> List.push(done, [next])
      }
      None -> List.push(done, [next])
    }
  })
}

fn metric(group: List<Series>, times: Times) -> Value {
  let (name, kind) = case group {
    [first, .._] -> (first.name, first.kind)
    [] -> ("", Kind.Count)
  }
  let points = Json.array(List.map(group, fn(series) { point(series, times) }))
  let data = case kind {
    Kind.Count -> ("sum", object([
      ("dataPoints", points),
      ("aggregationTemporality", Json.int(cumulative)),
      ("isMonotonic", Json.boolean(True)),
    ]))
    Kind.Gauge -> ("gauge", object([("dataPoints", points)]))
    Kind.Observe -> ("histogram", object([
      ("dataPoints", points),
      ("aggregationTemporality", Json.int(cumulative)),
    ]))
  }
  object([("name", Json.text(name)), data])
}

fn point(series: Series, times: Times) -> Value {
  let common = [
    ("attributes", Json.array(List.map(series.labels, fn(label) {
      let (key, value) = label
      attribute(key, value)
    }))),
    ("startTimeUnixNano", Json.text(times.start)),
    ("timeUnixNano", Json.text(times.end)),
  ]
  let values = case (series.kind, series.histogram) {
    (Kind.Count, _) -> [("asInt", as_text(series.value))]
    (Kind.Gauge, _) -> [("asDouble", series.value)]
    (Kind.Observe, Some(histogram)) -> [
      ("count", as_text(histogram.count)),
      ("sum", histogram.sum),
      ("bucketCounts", Json.array(List.map(histogram.buckets, as_text))),
      ("explicitBounds", Json.array(histogram.bounds)),
    ]
    (Kind.Observe, None) -> []
  }
  object(List.append(common, values))
}

fn dropped(fields: Map<Text, Value>, times: Times) -> List<Value> {
  let totals = case Map.get(fields, "dropped") {
    Some(Value.Object(totals)) -> totals
    _ -> Map.empty()
  }
  List.filter_map([
    ("label_sets", "chimi.metrics.dropped_label_sets"),
    ("kind_conflicts", "chimi.metrics.dropped_kind_conflicts"),
  ], fn(entry) {
    let (key, name) = entry
    case Map.get(totals, key) {
      Some(Value.Number(number)) -> {
        let digits = spelling(number)
        case is_unsigned(digits) and digits != "0" {
          True -> Some(metric([simple(name, [], Kind.Count, Value.Number(number))], times))
          False -> None
        }
      }
      _ -> None
    }
  })
}

// An OTLP 64-bit integer: its decimal digits as a JSON string.
fn as_text(value: Value) -> Value {
  case value {
    Value.Number(number) -> Json.text(spelling(number))
    other -> other
  }
}

fn spelling(number: Number) -> Text {
  Json.encode(Value.Number(number))
}

fn attribute(key: Text, value: Text) -> Value {
  object([("key", Json.text(key)), ("value", object([("stringValue", Json.text(value))]))])
}

fn object(fields: List<(Text, Value)>) -> Value {
  Json.object(Map.from(fields))
}
