/// Running other programs. Starting one needs the `commands: Commands`
/// capability, which the runner supplies to `main`; a test supplies a fake
/// with `using`, or real programs on purpose with `Exec.host_for_tests()`.
///
/// ```text
/// pub fn main() -> Void needs { commands: Commands, console: Console } {
///   let status = Exec.run(Exec.command("git", ["fetch", "--quiet"]))
///   case Exec.succeeded(status) {
///     True -> console.write_line("fetched")
///     False -> console.write_line("git fetch failed: ${Debug.render(status)}")
///   }
/// }
/// ```
///
/// A `Command` is a value: the program, its arguments, its environment, its
/// working directory and where its standard streams go. Building one starts
/// nothing. `Exec.start(command, use)` starts it and hands the running
/// `Child` to `use`; when `use` returns or fails, a child still running is
/// killed and reaped, so no child outlives the code that started it.
/// `Exec.run(command)` starts it and waits for its `Status`, and
/// `Exec.capture(command)` also collects what it writes.
///
/// A stream set to `Stdio.Pipe` is read with `Exec.output(child)` or
/// `Exec.error_output(child)` and written with `Exec.input(child)`, as std/stream
/// readers and writers. Write a child's input from another task while you
/// read its output, since a child that fills its output pipe stops reading.
///
/// There is no shell: the arguments reach the program exactly as given, and
/// a program name without a `/` is looked up on the parent's `PATH`. An exit
/// with a nonzero code is a `Status`, not a failure; `ExecError` is only for
/// a command that could not start. Waiting lets other tasks run, and under
/// the virtual clock a task waiting for a child holds virtual time, since the
/// child runs in real time.

import std/debug as Debug
import std/duration as Duration.{Duration}
import std/list as List
import std/map as Map.{Map}
import std/option as Option.{None, Option, Some}
import std/path as Path.{Path}
import std/bytes as Bytes.{Bytes}
import std/resource as Resource
import std/result as Result.{Err, Ok, Result}
import std/stream as Stream.{Reader, StreamError, Writer}
import std/task as Task.{Task}

// 1. Public types.

/// The capability to start programs. The runner's provider starts real
/// processes; a fake is a record of this function.
pub interface Commands {
  /// Starts `command` and returns the running child.
  start: fn(Command) -> Child errors ExecError
}

/// A program to run and how to run it. Build one with `Exec.command`.
pub struct Command {
  program: Text,
  arguments: List<Text>,
  variables: List<(Text, Text)>,
  inherits_environment: Bool,
  directory: Option<Path>,
  stdin: Stdio,
  stdout: Stdio,
  stderr: Stdio,
  stop_within: Duration,
}

/// Where a child's standard stream goes.
pub enum Stdio {
  /// The parent's own stream.
  Inherit
  /// Nothing: reading gives end of input, and writes are discarded.
  Null
  /// A pipe to the parent: `Exec.input`, `Exec.output` or `Exec.error_output`.
  Pipe
}

/// A running child: `Exec.wait` for its status, `Exec.terminate` or
/// `Exec.kill` to stop it, and its piped streams.
pub struct Child {
  program: Text,
  wait: fn() -> Status errors ExecError,
  terminate: fn() -> Void,
  kill: fn() -> Void,
  release: fn() -> Void,
  // Each takes the program, which a fake's streams name in their failures.
  input: Option<fn(Text) -> Writer<ExecError>>,
  output: Option<fn(Text) -> Reader<ExecError>>,
  error_output: Option<fn(Text) -> Reader<ExecError>>,
}

/// How a child ended.
pub enum Status {
  /// It exited with this code; 0 means success by convention.
  Exited(code: Int)
  /// A signal ended it, such as 15 for SIGTERM or 9 for SIGKILL.
  Signaled(signal: Int)
}

// 2. Failure types.

/// Why a command could not start or be waited for.
pub enum ExecError {
  /// No program of that name exists, or none on `PATH`.
  NotFound(program: Text)
  /// The program exists but is not executable.
  PermissionDenied(program: Text)
  /// The working directory does not exist, is not a directory, or cannot be
  /// entered.
  InvalidDirectory(path: Path)
  /// The child was already released, or the stream was closed or stopped.
  Closed(program: Text)
  /// A write to the child's input after it stopped reading it.
  BrokenPipe(program: Text)
  /// Any other failure, with the operating system's words.
  Failed(program: Text, message: Text)
}

// 3. Building commands.

/// A command that runs `program` with `arguments`, inheriting the parent's
/// environment, working directory and standard streams.
///
/// Cost: O(1).
pub fn command(program: Text, arguments: List<Text>) -> Command {
  Command {
    program: program,
    arguments: arguments,
    variables: [],
    inherits_environment: True,
    directory: None,
    stdin: Stdio.Inherit,
    stdout: Stdio.Inherit,
    stderr: Stdio.Inherit,
    stop_within: Duration.seconds(5),
  }
}

/// The command with the environment variable `name` set to `value`, over
/// what it inherits. A later value for the same name wins.
///
/// Defects when: `name` is empty or holds `=`, once the command starts.
/// Cost: O(1).
pub fn variable(command: Command, name: Text, value: Text) -> Command {
  Command {
    program: command.program,
    arguments: command.arguments,
    variables: List.push(command.variables, (name, value)),
    inherits_environment: command.inherits_environment,
    directory: command.directory,
    stdin: command.stdin,
    stdout: command.stdout,
    stderr: command.stderr,
    stop_within: command.stop_within,
  }
}

/// The command with exactly `variables` as its environment, inheriting none
/// of the parent's and dropping any set by an earlier `Exec.variable`.
/// `Exec.variable` adds to it afterwards.
///
/// Cost: O(n).
pub fn environment(command: Command, variables: Map<Text, Text>) -> Command {
  Command {
    program: command.program,
    arguments: command.arguments,
    variables: Map.entries(variables),
    inherits_environment: False,
    directory: command.directory,
    stdin: command.stdin,
    stdout: command.stdout,
    stderr: command.stderr,
    stop_within: command.stop_within,
  }
}

/// The command run in `path` instead of the parent's working directory. A
/// relative program name with a `/` is found from the parent's directory.
///
/// Cost: O(1).
pub fn directory(command: Command, path: Path) -> Command {
  Command {
    program: command.program,
    arguments: command.arguments,
    variables: command.variables,
    inherits_environment: command.inherits_environment,
    directory: Some(path),
    stdin: command.stdin,
    stdout: command.stdout,
    stderr: command.stderr,
    stop_within: command.stop_within,
  }
}

/// The command with its standard input connected to `stdio`.
///
/// Cost: O(1).
pub fn stdin(command: Command, stdio: Stdio) -> Command {
  Command {
    program: command.program,
    arguments: command.arguments,
    variables: command.variables,
    inherits_environment: command.inherits_environment,
    directory: command.directory,
    stdin: stdio,
    stdout: command.stdout,
    stderr: command.stderr,
    stop_within: command.stop_within,
  }
}

/// The command with its standard output connected to `stdio`.
///
/// Cost: O(1).
pub fn stdout(command: Command, stdio: Stdio) -> Command {
  Command {
    program: command.program,
    arguments: command.arguments,
    variables: command.variables,
    inherits_environment: command.inherits_environment,
    directory: command.directory,
    stdin: command.stdin,
    stdout: stdio,
    stderr: command.stderr,
    stop_within: command.stop_within,
  }
}

/// The command with its standard error connected to `stdio`.
///
/// Cost: O(1).
pub fn stderr(command: Command, stdio: Stdio) -> Command {
  Command {
    program: command.program,
    arguments: command.arguments,
    variables: command.variables,
    inherits_environment: command.inherits_environment,
    directory: command.directory,
    stdin: command.stdin,
    stdout: command.stdout,
    stderr: stdio,
    stop_within: command.stop_within,
  }
}

/// The command with `duration` as the time its child has to exit after
/// SIGTERM when its `Exec.start` ends while it runs, before SIGKILL. It is
/// 5 seconds unless set; zero sends SIGKILL at once. It is real time, as the
/// child runs in, under the virtual clock too. A time under a millisecond
/// counts as zero.
///
/// Defects when: `duration` is negative.
/// Cost: O(1).
pub fn stop_within(command: Command, duration: Duration) -> Command {
  case duration < Duration.zero {
    True -> Debug.crash("Exec: stop_within must not be negative, got ${Duration.to_text(duration)}")
    False -> Void
  }
  Command {
    program: command.program,
    arguments: command.arguments,
    variables: command.variables,
    inherits_environment: command.inherits_environment,
    directory: command.directory,
    stdin: command.stdin,
    stdout: command.stdout,
    stderr: command.stderr,
    stop_within: duration,
  }
}

/// The program the command runs, as given.
///
/// Cost: O(1).
pub fn program(command: Command) -> Text {
  command.program
}

/// The command's arguments, without the program name.
///
/// Cost: O(1).
pub fn arguments(command: Command) -> List<Text> {
  command.arguments
}

// 4. Running commands.

/// Starts `command`, hands the running child to `use`, and returns what `use`
/// returns. When `use` returns or fails, a child still running is asked to
/// stop with SIGTERM, given the command's `Exec.stop_within` time (5 seconds)
/// to exit, then killed with SIGKILL, and reaped; other tasks run meanwhile.
/// A child's own children are not stopped: a program that starts others and
/// leaves them running leaves them to outlive it.
///
/// Calls: `use` once, with the child, unless the command cannot start.
/// Fails with: `ExecError.NotFound`, `PermissionDenied`, `InvalidDirectory`
/// or `Failed` when the command cannot start; what `use` fails with.
pub fn start<T, E, R>(command: Command, use: fn(Child) -> T errors E needs R) -> T needs R + {
  commands: Commands
} {
  Resource.scoped(fn() {
    named(commands.start(command), command.program)
  }, fn(child) { child.release() }, use)
}

/// Starts `command` and waits until it ends.
///
/// Fails with: `ExecError.NotFound`, `PermissionDenied`, `InvalidDirectory`
/// or `Failed` when the command cannot start.
pub fn run(command: Command) -> Status needs {
  commands: Commands
} {
  start(command, wait)
}

/// Runs `command` with its standard input `Stdio.Null` and its output and
/// error output piped, and returns a record of how it ended (`status`) and
/// everything it wrote to each (`output`, `error_output`),
/// read side by side so neither pipe fills. A nonzero exit is in `status`,
/// not a failure. It waits for the end of both streams, which a program's own
/// child that keeps them open delays.
///
/// Fails with: `ExecError.NotFound`, `PermissionDenied`, `InvalidDirectory`
/// or `Failed` when the command cannot start or a read fails.
/// Cost: O(n) in the bytes written, all held in memory.
pub fn capture(command: Command) -> { status: Status, output: Bytes, error_output: Bytes } needs {
  commands: Commands
} {
  let piped = stderr(stdout(stdin(command, Stdio.Null), Stdio.Pipe), Stdio.Pipe)
  start(piped, fn(child) {
    let written = read_in_task(output(child))
    let failed = read_in_task(error_output(child))
    let status = wait(child)
    {
      status: status, output: Task.result(written), error_output: Task.result(failed)
    }
  })
}

/// The child's standard input, when the command set it to `Stdio.Pipe`.
/// Close it when done writing: a child reading to the end of its input,
/// such as `cat`, exits only then, and `Exec.wait` does not close it, since
/// another task may still be writing.
///
/// Defects when: the command did not set stdin to `Stdio.Pipe`.
/// Cost: O(1).
pub fn input(child: Child) -> Writer<ExecError> {
  case child.input {
    Some(make) -> make(child.program)
    None -> Debug.crash("Exec: ${child.program} was started without Stdio.Pipe for stdin")
  }
}

/// The child's standard output, when the command set it to `Stdio.Pipe`.
/// It ends once the child, and any program holding the pipe after it, has
/// closed it. Stopping it early makes the child's next write to it fail.
///
/// Defects when: the command did not set stdout to `Stdio.Pipe`.
/// Cost: O(1).
pub fn output(child: Child) -> Reader<ExecError> {
  case child.output {
    Some(make) -> make(child.program)
    None -> Debug.crash("Exec: ${child.program} was started without Stdio.Pipe for stdout")
  }
}

/// The child's standard error, when the command set it to `Stdio.Pipe`.
///
/// Defects when: the command did not set stderr to `Stdio.Pipe`.
/// Cost: O(1).
pub fn error_output(child: Child) -> Reader<ExecError> {
  case child.error_output {
    Some(make) -> make(child.program)
    None -> Debug.crash("Exec: ${child.program} was started without Stdio.Pipe for stderr")
  }
}

/// Waits until the child ends and returns how. Asking again returns the same
/// status at once. It leaves a piped input open: close it first if the child
/// waits for the end of its input. Other tasks run meanwhile, and a cancelled task stops
/// waiting at once; the child keeps running until its `Exec.start` ends.
///
/// Fails with: `ExecError.Closed` when the child was released;
/// `ExecError.Failed` when the operating system cannot wait for it.
pub fn wait(child: Child) -> Status {
  child.wait()
}

/// Asks the child to stop with SIGTERM. Does nothing once it has been waited
/// for.
///
/// Cost: one system call.
pub fn terminate(child: Child) -> Void {
  child.terminate()
}

/// Stops the child at once with SIGKILL. Does nothing once it has been
/// waited for.
///
/// Cost: one system call.
pub fn kill(child: Child) -> Void {
  child.kill()
}

/// True when the child exited with code 0.
///
/// Cost: O(1).
pub fn succeeded(status: Status) -> Bool {
  status == Status.Exited(0)
}

// 5. Fakes.

/// A child whose operations are these functions, for a fake `Commands`.
/// `release` runs when the `Exec.start` that started it ends. It has no
/// piped streams; `Exec.piped` gives it some.
///
/// Cost: O(1).
pub fn child(
  wait: fn() -> Status errors ExecError,
  terminate: fn() -> Void,
  kill: fn() -> Void,
  release: fn() -> Void,
) -> Child {
  Child {
    program: "",
    wait: wait,
    terminate: terminate,
    kill: kill,
    release: release,
    input: None,
    output: None,
    error_output: None,
  }
}

/// The fake `child` with these streams as its piped input, output and
/// error output, such as a `Stream.pipe` end or `Stream.from_bytes`. Their
/// `StreamError.Closed` and `Aborted` read as `ExecError.Closed` for the
/// output streams (as a host read after a stop does), `Closed` as
/// `ExecError.BrokenPipe` for the input, and anything else as `Failed`. Make
/// the streams inside the fake's `start`: a provider goes to every task its
/// caller starts, and a channel end it held would belong to one of them. A
/// fake cannot tell a write after `Stream.close` from one after the reader
/// stopped: both are `BrokenPipe`, where a host pipe gives `Closed` for the
/// first. For
/// the same reason a stream of a fake is used by one task: hand a writer
/// task `Exec.input(child)`, not the child.
///
/// Cost: O(1).
pub fn piped(
  child: Child,
  input: Writer<StreamError>,
  output: Reader<StreamError>,
  error_output: Reader<StreamError>,
) -> Child {
  Child {
    program: child.program,
    wait: child.wait,
    terminate: child.terminate,
    kill: child.kill,
    release: child.release,
    input: Some(fake_input(input)),
    output: Some(fake_output(output)),
    error_output: Some(fake_output(error_output)),
  }
}

// 6. Runner provider.

fn stdio_code(stdio: Stdio) -> Int {
  case stdio {
    Stdio.Inherit -> 0
    Stdio.Null -> 1
    Stdio.Pipe -> 2
  }
}

// The child as `Exec.start` hands it out, naming the program it runs.
fn named(child: Child, program: Text) -> Child {
  Child {
    program: program,
    wait: child.wait,
    terminate: child.terminate,
    kill: child.kill,
    release: child.release,
    input: child.input,
    output: child.output,
    error_output: child.error_output,
  }
}

// A task reading every byte of `reader`. Its own function, so the task
// holds only that stream: a fake's streams may hold channel ends, which one
// task at a time owns.
fn read_in_task<E>(reader: Reader<E>) -> Task<Bytes, E> {
  Task.start(fn() { everything(reader) })
}

// Every byte of `reader`, with no limit.
fn everything<E>(reader: Reader<E>) -> Bytes {
  let parts = loop parts = [] {
    let next = Stream.read(reader)
    case next {
      None -> break parts
      Some(chunk) -> List.push(parts, chunk)
    }
  }
  Bytes.concat(parts)
}

fn fake_failure(error: StreamError, program: Text, closed: ExecError) -> ExecError {
  case error {
    StreamError.Closed -> closed
    other -> ExecError.Failed(program, Debug.render(other))
  }
}

// A read after the reader was stopped is `Aborted` from std/stream and
// `Closed` from a host pipe.
fn fake_read_failure(error: StreamError, program: Text) -> ExecError {
  case error {
    StreamError.Aborted -> ExecError.Closed(program)
    other -> fake_failure(other, program, ExecError.Closed(program))
  }
}

// One function per stream, so each closure holds only its own stream: a
// fake's streams may hold channel ends, which one task at a time owns.
fn fake_input(writer: Writer<StreamError>) -> fn(Text) -> Writer<ExecError> {
  fn(program) { fake_writer(writer, program) }
}

fn fake_output(reader: Reader<StreamError>) -> fn(Text) -> Reader<ExecError> {
  fn(program) { fake_reader(reader, program) }
}

fn fake_reader(reader: Reader<StreamError>, program: Text) -> Reader<ExecError> {
  Stream.reader(fn() {
    case Result.capture(fn() { Stream.read(reader) }) {
      Ok(chunk) -> chunk
      Err(error) -> Failure(fake_read_failure(error, program))
    }
  }, fn() { Stream.stop(reader) })
}

fn fake_writer(writer: Writer<StreamError>, program: Text) -> Writer<ExecError> {
  Stream.writer(fn(bytes) {
    case Result.capture(fn() { Stream.write(writer, bytes) }) {
      Ok(done) -> done
      Err(error) -> Failure(fake_failure(error, program, ExecError.BrokenPipe(program)))
    }
  }, fn() {
    case Result.capture(fn() { Stream.close(writer) }) {
      Ok(done) -> done
      Err(error) -> Failure(fake_failure(error, program, ExecError.Closed(program)))
    }
  })
}

// The binding's failure codes (runtime/native/bindings/exec/exec.c): a
// spawn fails with 1, 2, 3 or 5, and a wait with 4 or 5.
fn started<T>(command: Command, result: Result<T, (Int, Text)>) -> T {
  case result {
    Ok(value) -> value
    Err((1, _)) -> Failure(ExecError.NotFound(command.program))
    Err((2, _)) -> Failure(ExecError.PermissionDenied(command.program))
    Err((3, _)) -> Failure(ExecError.InvalidDirectory(
      case command.directory {
        Some(path) -> path
        None -> Debug.crash("Exec: an invalid directory without one")
      },
    ))
    Err((_, message)) -> Failure(ExecError.Failed(command.program, message))
  }
}

// A wait, read or write fails with 4, 5 or (a write) 6.
fn waited<T>(command: Command, result: Result<T, (Int, Text)>) -> T {
  case result {
    Ok(value) -> value
    Err((4, _)) -> Failure(ExecError.Closed(command.program))
    Err((6, _)) -> Failure(ExecError.BrokenPipe(command.program))
    Err((_, message)) -> Failure(ExecError.Failed(command.program, message))
  }
}

fn host_writer(command: Command, pipe: Pipe) -> Writer<ExecError> {
  Stream.writer(fn(bytes) {
    waited(command, native_write(pipe, bytes))
  }, fn() { native_close_pipe(pipe) })
}

fn host_reader(command: Command, pipe: Pipe) -> Reader<ExecError> {
  Stream.reader(fn() { waited(command, native_read(pipe)) }, fn() { native_close_pipe(pipe) })
}

fn close_pipe(pipe: Option<Pipe>) -> Void {
  case pipe {
    Some(open) -> native_close_pipe(open)
    None -> Void
  }
}

fn status(ended: (Int, Int)) -> Status {
  case ended {
    (0, code) -> Status.Exited(code)
    (_, signal) -> Status.Signaled(signal)
  }
}

fn host_start(command: Command) -> Child {
  let builder = native_command(command.program)
  List.each(command.arguments, fn(argument) { native_argument(builder, argument) })
  case command.inherits_environment {
    True -> Void
    False -> native_clear_environment(builder)
  }
  List.each(command.variables, fn(variable) {
    let (name, value) = variable
    native_variable(builder, name, value)
  })
  case command.directory {
    Some(path) -> native_directory(builder, Path.to_text(path))
    None -> Void
  }
  let (process, input_pipe, output_pipe, errors_pipe) = started(
    command,
    native_spawn(builder, stdio_code(command.stdin), stdio_code(command.stdout), stdio_code(command.stderr)),
  )
  Child {
    program: command.program,
    wait: fn() {
      status(waited(command, native_wait(process)))
    },
    terminate: fn() { native_terminate(process) },
    kill: fn() { native_kill(process) },
    release: fn() {
      // Closed first: input's end is the gentlest stop, and a child flushing
      // output on SIGTERM must not wait on a reader that is gone.
      close_pipe(input_pipe)
      close_pipe(output_pipe)
      close_pipe(errors_pipe)
      native_stop(process, Duration.to_milliseconds(command.stop_within))
      native_release(process)
    },
    input: Option.map(input_pipe, fn(pipe) {
      fn(_program) { host_writer(command, pipe) }
    }),
    output: Option.map(output_pipe, fn(pipe) {
      fn(_program) { host_reader(command, pipe) }
    }),
    error_output: Option.map(errors_pipe, fn(pipe) {
      fn(_program) { host_reader(command, pipe) }
    }),
  }
}

native type Builder
native type Process
native type Pipe

native fn native_command(program: Text) -> Builder
native fn native_argument(builder: Builder, argument: Text) -> Void
native fn native_variable(builder: Builder, name: Text, value: Text) -> Void
native fn native_clear_environment(builder: Builder) -> Void
native fn native_directory(builder: Builder, path: Text) -> Void
native fn native_spawn(
  builder: Builder,
  stdin: Int,
  stdout: Int,
  stderr: Int,
) -> Result<(Process, Option<Pipe>, Option<Pipe>, Option<Pipe>), (Int, Text)>
native fn native_read(pipe: Pipe) -> Result<Option<Bytes>, (Int, Text)>
native fn native_write(pipe: Pipe, bytes: Bytes) -> Result<Void, (Int, Text)>
native fn native_close_pipe(pipe: Pipe) -> Void
native fn native_wait(process: Process) -> Result<(Int, Int), (Int, Text)>
native fn native_terminate(process: Process) -> Void
native fn native_kill(process: Process) -> Void
native fn native_stop(process: Process, milliseconds: Int) -> Void
native fn native_release(process: Process) -> Void
native fn native_allow_real_commands() -> Void

// The provider the runner binds to `main`'s `commands` need (operations.rs
// `RUNNER_PROVIDERS`). Private, so no other code can take the capability
// without declaring the need.
fn system() {
  { start: host_start }
}

/// The operating system's programs, for a test that means to run real ones:
/// `run() using { commands: Exec.host_for_tests() }`. Test-only (`T4401`): a
/// program gets the capability only by declaring the need.
pub fn host_for_tests() {
  native_allow_real_commands()
  system()
}
