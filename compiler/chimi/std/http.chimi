/// HTTP/1.1 servers over `std/net`. A handler is a function from a `Request`
/// to a `Response`, so routing is a `case` on the method and the path:
///
/// ```text
/// fn handle(request: Request) -> Response {
///   case (Http.method(request), Http.path(request)) {
///     (Method.Get, ["health"]) -> Http.text(200, "ok")
///     (Method.Get, ["users", id]) -> Http.text(200, "user ${id}")
///     _ -> Http.text(404, "not found")
///   }
/// }
///
/// pub fn main() -> Void needs { network: Network, clock: Clock } {
///   Resource.scoped(fn() { Net.listen("", 8080) }, Net.close_listener, fn(listener) {
///     Http.serve(listener, Http.defaults, handle)
///   })
/// }
/// ```
///
/// Each connection runs in its own process and keeps its connection open
/// between requests (keep-alive) unless the client or the handler asks to
/// close it. A request's body is read whole before the handler runs, up to a
/// limit. A malformed request gets the matching error status (400, 413, 431,
/// 501 or 505) and its connection is closed; a handler's expected failure
/// answers 500.
/// A handler's defect ends only its own connection, which closes without an
/// answer; the server and its other connections carry on.
///
/// A server takes its settings as a record: start from `Http.defaults` and
/// name what differs, as `Http.serve(listener, { ..Http.defaults,
/// request_timeout: Duration.seconds(5) }, handle)`. The request shape is
/// provisional (decisions.md, 2026-11-16).

import std/bytes as Bytes
import std/bytes.{Bytes}
import std/clock as Clock
import std/clock.{Clock}
import std/debug as Debug
import std/duration as Duration
import std/duration.{Duration}
import std/int as Int
import std/list as List
import std/net as Net
import std/net.{Connection, Listener, NetError}
import std/process as Process
import std/process.{HandoffSpec, Inbox}
import std/resource as Resource
import std/result as Result
import std/select as Select
import std/result.{Err, Ok}
import std/stream as Stream
import std/stream.{Reader, Writer}
import std/supervisor as Supervisor
import std/supervisor.{HandoffError, Running}
import std/task as Task
import std/text as Text

// 1. Public types.

/// A request's method. Methods outside the common ones keep their name.
pub enum Method {
  Get
  Head
  Post
  Put
  Patch
  Delete
  Options
  Other(name: Text)
}

/// One request, with its body read whole. Read it with `Http.method`,
/// `Http.path`, `Http.query`, `Http.header`, `Http.headers` and `Http.body`.
pub struct Request {
  method: Method,
  path: List<Text>,
  query: Text,
  headers: List<(Text, Text)>,
  body: Bytes,
}

/// One response. Build it with `Http.response` or `Http.text`.
pub struct Response {
  status: Int,
  headers: List<(Text, Text)>,
  body: Bytes,
}

// 2. Reading requests.

/// The request's method.
///
/// Cost: O(1).
pub fn method(request: Request) -> Method {
  request.method
}

/// The request's path as its segments, without the query: `/users/7/` is
/// `["users", "7"]`, and `/` is `[]`. Segments are as the client sent them,
/// percent escapes included.
///
/// Cost: O(1).
pub fn path(request: Request) -> List<Text> {
  request.path
}

/// The part of the target after `?`, or `""` when there is none.
///
/// Cost: O(1).
pub fn query(request: Request) -> Text {
  request.query
}

/// The first value of the header `name`, matched without regard to case.
///
/// Cost: O(n) in the headers.
pub fn header(request: Request, name: Text) -> Option<Text> {
  find_header(request.headers, ascii_lowercase(name))
}

/// Every header as a lowercase name and its value, in the order received.
///
/// Cost: O(1).
pub fn headers(request: Request) -> List<(Text, Text)> {
  request.headers
}

/// The request's body; empty when it has none.
///
/// Cost: O(1).
pub fn body(request: Request) -> Bytes {
  request.body
}

/// A request, for testing a handler without a connection. `query` is the
/// text `Http.query` returns. Header names are matched without regard to
/// case.
///
/// Cost: O(n) in the headers.
pub fn request(method: Method, path: List<Text>, query: Text, headers: List<(Text, Text)>, body: Bytes) -> Request {
  Request(method, path, query, lowercase_names(headers), body)
}

// 3. Building responses.

/// A response with `status`, `headers` and `body`. `content-length` is added
/// when it is sent; a `connection: close` header closes the connection after
/// it.
///
/// Defects when: `status` is outside 200 to 599 (the server sends `100
/// Continue` itself), a header name is not a token, or a header value holds
/// a control character other than a tab (a line break would let the value
/// write headers of its own). Headers that frame the message or manage the
/// connection (`content-length`, `transfer-encoding`, `connection` and the
/// like) are replaced by the server's own when it is sent, except that a
/// 304 keeps a `content-length` the handler gives.
/// Cost: O(n) in the headers.
pub fn response(status: Int, headers: List<(Text, Text)>, body: Bytes) -> Response {
  Response(checked_status(status), List.map(headers, checked_header), body)
}

/// A plain-text response: `text` as UTF-8, with
/// `content-type: text/plain; charset=utf-8`.
///
/// Defects when: `status` is outside 200 to 599.
/// Cost: O(n) in `text`.
pub fn text(status: Int, text: Text) -> Response {
  response(status, [("content-type", "text/plain; charset=utf-8")], Bytes.from_text(text))
}

/// The response's status code.
///
/// Cost: O(1).
pub fn status(response: Response) -> Int {
  response.status
}

/// The response's headers, with lowercase names.
///
/// Cost: O(1).
pub fn response_headers(response: Response) -> List<(Text, Text)> {
  response.headers
}

/// The response's body.
///
/// Cost: O(1).
pub fn response_body(response: Response) -> Bytes {
  response.body
}

// 4. Serving.

/// A server's settings, to update with what differs: requests whose head
/// (request line and headers) passes `max_head_bytes` get 431, as do those
/// with more than `max_headers` headers or chunked-body trailer lines; a body
/// over `max_body_bytes` gets 413; a connection closes when the next request
/// takes longer than `request_timeout` to arrive (counted from the end of the
/// previous answer, body included), or a response longer than
/// `write_timeout` to send. At most `max_connections` connections are served
/// at once; past that, `Http.serve` closes a new connection at once. The
/// defaults are 64 KiB, 100 headers, 8 MiB, 60 s, 60 s and 512 connections.
/// `max_body_bytes` may be 0 (no bodies); the others must be positive, and
/// `Http.serve` and `Http.serve_connection` defect otherwise.
pub const defaults: { max_head_bytes: Int, max_headers: Int, max_body_bytes: Int, request_timeout: Duration, write_timeout: Duration, max_connections: Int } = {
  max_head_bytes: 65536,
  max_headers: 100,
  max_body_bytes: 8388608,
  request_timeout: Duration.seconds(60),
  write_timeout: Duration.seconds(60),
  max_connections: 512,
}

/// Accepts connections on `listener` and answers each request on them with
/// `handle`, until the listener is closed. Each connection runs in its own
/// process under a supervisor that never restarts one, so a defect in
/// `handle` closes only the connection it happened on. While
/// `max_connections` are open, a new connection is closed as soon as it is
/// accepted, as Node's `server.maxConnections` does. A failed accept, such as running out
/// of file descriptors or a client that reset before it was accepted, is
/// retried after a pause that grows from 10 ms to 1 s, so a burst of failures
/// neither ends serving nor spins. When serving ends, by the listener
/// closing or the calling task being cancelled, the connections still open
/// are stopped, which closes them.
///
/// Fails with: nothing; only closing the listener ends serving.
/// Defects when: never because of `handle`.
pub fn serve<E, R>(listener: Listener, settings: { max_head_bytes: Int, max_headers: Int, max_body_bytes: Int, request_timeout: Duration, write_timeout: Duration, max_connections: Int }, handle: fn(Request) -> Response errors E needs R) -> Void needs R + {
  clock: Clock
} {
  let _ = limits(settings)
  // The connection is served in a task the process waits on. When serving
  // ends, the supervisor's stop makes the inbox ready, so the process ends
  // and cancels that task, which closes the connection. A forced stop runs
  // no more of the process's code, so it would leave the connection open.
  let connection = Process.handoff_spec(fn(inbox: Inbox<Unused>, accepted: Connection) {
    let serving = Task.start(fn() { serve_connection(accepted, settings, handle) })
    Select.first([Select.task(serving, fn(_) { Void }), Select.inbox(inbox, fn(_) { Void })])
  }, 1, Duration.seconds(1))
  Resource.scoped(fn() {
    Supervisor.start(Supervisor.policy([], settings.max_connections, Supervisor.restarts(0, Duration.seconds(1))))
  }, Supervisor.stop, fn(connections) {
    loop pause = 10 {
      case Result.capture(fn() { Net.accept(listener) }) {
        Err(NetError.Closed) -> break Void
        Err(_) -> {
          Clock.sleep(Duration.milliseconds(pause))
          smaller(pause * 2, 1000)
        }
        Ok(accepted) -> {
          admit(connections, connection, accepted)
          10
        }
      }
    }
  })
}

// A connection process's mailbox, which nothing sends to.
enum Unused {
  Unused
}

// Starts `accepted`'s process, or closes it when the server is at its cap or
// stopping.
fn admit<E>(connections: Running, spec: HandoffSpec<Connection, Unused, E>, accepted: Connection) -> Void {
  case Supervisor.start_handoff(connections, spec, accepted) {
    Success(_) -> Void
    Failure(HandoffError.CapacityReached(back)) -> Net.close(back)
    Failure(HandoffError.Stopped(back)) -> Net.close(back)
  }
}

/// Answers the requests on one connection with `handle`, in order, until the
/// client closes it, a request or response asks to close it, a request is
/// malformed, or a request or response passes the settings' idle or write
/// timeout. Then it closes the connection, also when
/// the task is cancelled. For a server built on its own accept loop, and for
/// tests over `Net.pair`.
///
/// Fails with: nothing; a failure of the connection ends it.
/// Defects when: `handle` defects.
pub fn serve_connection<E, R>(connection: Connection, settings: { max_head_bytes: Int, max_headers: Int, max_body_bytes: Int, request_timeout: Duration, write_timeout: Duration, max_connections: Int }, handle: fn(Request) -> Response errors E needs R) -> Void needs R + {
  clock: Clock
} {
  Resource.scoped(fn() { connection }, Net.close, fn(open) {
    let _ = Result.capture(fn() {
      exchange_all(open, limits(settings), handle)
    })
    Void
  })
}

// 5. The exchange loop.

// The limits a server applies, from its settings.
struct Limits {
  head_bytes: Int,
  header_count: Int,
  body_bytes: Int,
  idle: Duration,
  write: Duration,
}

fn limits(settings: { max_head_bytes: Int, max_headers: Int, max_body_bytes: Int, request_timeout: Duration, write_timeout: Duration, max_connections: Int }) -> Limits {
  case (settings.max_head_bytes > 0 and settings.max_headers > 0 and settings.max_body_bytes >= 0 and settings.max_connections > 0, positive(settings.request_timeout) and positive(settings.write_timeout)) {
    (True, True) -> Void
    (False, _) -> Debug.crash("Http: max_head_bytes, max_headers and max_connections must be positive, and max_body_bytes not negative")
    (_, False) -> Debug.crash("Http: request_timeout and write_timeout must be positive")
  }
  Limits(settings.max_head_bytes, settings.max_headers, settings.max_body_bytes, settings.request_timeout, settings.write_timeout)
}

fn positive(duration: Duration) -> Bool {
  duration > Duration.zero
}

// Why a request cannot be answered; each has its status.
enum Refusal {
  Malformed(reason: Text)
  HeadTooLarge
  BodyTooLarge
  NotImplemented(reason: Text)
  BadVersion
}

// What reading the next request found.
enum Next {
  Arrived(request: Request, keep_alive: Bool, minor: Int, rest: Cursor)
  Ended
  Refused(refusal: Refusal)
}

fn exchange_all<E, R>(connection: Connection, bounds: Limits, handle: fn(Request) -> Response errors E needs R) -> Void needs R + {
  clock: Clock
} {
  let reader = Net.reader(connection)
  let writer = Net.writer(connection)
  loop cursor = Cursor(Bytes.empty(), 0) {
    let next = Task.timeout(fn() {
      read_request(reader, writer, cursor, bounds)
    }, bounds.idle)
    case next {
      Next.Ended -> break Void
      Next.Refused(refusal) -> {
        Task.timeout(fn() {
          write_response(writer, refusal_response(refusal), now(), False, 1, False)
        }, bounds.write)
        linger(reader, writer)
        break Void
      }
      Next.Arrived(request, keep_alive, minor, rest) -> {
        let answer = answer(request, handle)
        let keep = keep_alive and not List.contains(header_tokens(answer.headers, "connection"), "close")
        Task.timeout(fn() {
          write_response(writer, answer, now(), keep, minor, request.method == Method.Head)
        }, bounds.write)
        case keep {
          True -> rest
          False -> {
            linger(reader, writer)
            break Void
          }
        }
      }
    }
  }
}

// After a closing answer, stops writing and drops what the client still
// sends, for up to 2 s, before the connection closes. Closing with unread
// input would make the client's system answer with a reset, which can throw
// away the answer before the client reads it (RFC 9112 section 9.6; Go waits
// 500 ms, nginx up to 5 s).
fn linger(reader: Reader<NetError>, writer: Writer<NetError>) -> Void needs {
  clock: Clock
} {
  let _ = Result.capture(fn() {
    Stream.close(writer)
    Task.timeout(fn() {
      loop more = True {
        let chunk = Stream.read(reader)
        case chunk {
          Some(_) -> True
          None -> break Void
        }
      }
    }, Duration.seconds(2))
  })
  Void
}

fn answer<E, R>(request: Request, handle: fn(Request) -> Response errors E needs R) -> Response needs R {
  case Result.capture(fn() { handle(request) }) {
    Ok(response) -> response
    Err(_) -> text(500, "internal server error")
  }
}

// 6. Reading a request.

fn read_request(reader: Reader<NetError>, writer: Writer<NetError>, cursor: Cursor, bounds: Limits) -> Next {
  case read_head(reader, cursor, bounds.head_bytes) {
    Success(None) -> Next.Ended
    Success(Some((head, rest))) -> case parse_head(head, bounds) {
      Success(parsed) -> read_body(reader, writer, parsed, rest, bounds)
      Failure(refusal: Refusal) -> Next.Refused(refusal)
    }
    Failure(refusal: Refusal) -> Next.Refused(refusal)
    Failure(error) -> Failure(error)
  }
}

// A parsed head: the method, target and version it starts with, and its
// headers.
struct Parsed {
  method: Method,
  path: List<Text>,
  query: Text,
  minor: Int,
  headers: List<(Text, Text)>,
}

fn read_body(reader: Reader<NetError>, writer: Writer<NetError>, head: Parsed, cursor: Cursor, bounds: Limits) -> Next {
  case body_framing(head) {
    Failure(refusal: Refusal) -> Next.Refused(refusal)
    Success(Framing.Empty) -> arrived(head, Bytes.empty(), cursor)
    Success(Framing.Length(length)) -> case length > bounds.body_bytes {
      True -> Next.Refused(Refusal.BodyTooLarge)
      False -> {
        continue_if_expected(writer, head)
        case read_exact(reader, cursor, length) {
          Success((body, rest)) -> arrived(head, body, rest)
          Failure(refusal: Refusal) -> Next.Refused(refusal)
          Failure(error) -> Failure(error)
        }
      }
    }
    Success(Framing.Chunked) -> {
      continue_if_expected(writer, head)
      case read_chunked(reader, cursor, bounds) {
        Success((body, rest)) -> arrived(head, body, rest)
        Failure(refusal: Refusal) -> Next.Refused(refusal)
        Failure(error) -> Failure(error)
      }
    }
  }
}

fn arrived(head: Parsed, body: Bytes, rest: Cursor) -> Next {
  Next.Arrived(Request(head.method, head.path, head.query, head.headers, body), keeps_alive(head), head.minor, rest)
}

// An HTTP/1.1 client that sent `expect: 100-continue` waits for this before
// its body; HTTP/1.0 has no such status.
fn continue_if_expected(writer: Writer<NetError>, head: Parsed) -> Void {
  case find_header(head.headers, "expect") {
    Some(value) -> case ascii_lowercase(value) == "100-continue" and head.minor == 1 {
      True -> Stream.write(writer, Bytes.from_text("HTTP/1.1 100 Continue\r\n\r\n"))
      False -> Void
    }
    None -> Void
  }
}

// HTTP/1.1 keeps the connection unless it says `close`; HTTP/1.0 closes it
// unless it says `keep-alive`.
fn keeps_alive(head: Parsed) -> Bool {
  let tokens = header_tokens(head.headers, "connection")
  case head.minor == 1 {
    True -> not List.contains(tokens, "close")
    False -> List.contains(tokens, "keep-alive")
  }
}

enum Framing {
  Empty
  Length(length: Int)
  Chunked
}

// How the body is framed (RFC 9112 section 6.3). Every transfer-encoding
// header counts, joined, so a second one cannot hide a coding; chunked is
// the only coding read.
fn body_framing(head: Parsed) -> Framing {
  let codings = header_tokens(head.headers, "transfer-encoding")
  let lengths = header_tokens(head.headers, "content-length")
  let encoded = List.any(head.headers, fn(header) {
    let (name, _) = header
    name == "transfer-encoding"
  })
  let measured = List.any(head.headers, fn(header) {
    let (name, _) = header
    name == "content-length"
  })
  case measured and List.is_empty(lengths) {
    True -> Failure(Refusal.Malformed("content-length is not a number"))
    False -> Void
  }
  case (encoded, lengths) {
    (True, [_, ..]) -> Failure(Refusal.Malformed("both content-length and transfer-encoding"))
    (True, []) -> case (head.minor == 1, codings, List.last(codings)) {
      (False, _, _) -> Failure(Refusal.Malformed("transfer-encoding in HTTP/1.0"))
      (True, ["chunked"], _) -> Framing.Chunked
      (True, _, Some("chunked")) -> Failure(Refusal.NotImplemented("transfer codings other than chunked"))
      _ -> Failure(Refusal.Malformed("chunked is not the final transfer coding"))
    }
    (False, []) -> Framing.Empty
    (False, [first, ..rest]) -> case List.all(rest, fn(other) { other == first }) {
      True -> Framing.Length(parse_length(first))
      False -> Failure(Refusal.Malformed("conflicting content-length"))
    }
  }
}

fn parse_length(value: Text) -> Int {
  case all_digits(value) {
    True -> case Result.capture(fn() { Int.parse(value) }) {
      Ok(length) -> length
      Err(_) -> Failure(Refusal.BodyTooLarge)
    }
    False -> Failure(Refusal.Malformed("content-length is not a number"))
  }
}

fn all_digits(text: Text) -> Bool {
  let bytes = Bytes.to_list(Bytes.from_text(text))
  (not List.is_empty(bytes)) and List.all(bytes, is_digit)
}

fn is_digit(byte: Int) -> Bool {
  byte >= 48 and byte <= 57
}

// 7. Parsing a head.

fn parse_head(bytes: Bytes, bounds: Limits) -> Parsed {
  case List.any(Bytes.to_list(bytes), is_control) {
    True -> Failure(Refusal.Malformed("a control character in the head"))
    False -> Void
  }
  let text = case Result.capture(fn() { Bytes.to_text(bytes) }) {
    Ok(text) -> text
    Err(_) -> Failure(Refusal.Malformed("the head is not UTF-8"))
  }
  let lines = Text.split(text, "\r\n")
  case List.any(lines, fn(line) {
    Text.contains(line, "\r") or Text.contains(line, "\n")
  }) {
    True -> Failure(Refusal.Malformed("a line break that is not CRLF"))
    False -> Void
  }
  case lines {
    [] -> Failure(Refusal.Malformed("no request line"))
    [request_line, ..header_lines] -> {
      case List.length(header_lines) > bounds.header_count {
        True -> Failure(Refusal.HeadTooLarge)
        False -> Void
      }
      let (method, target, minor) = parse_request_line(request_line)
      let (path, query, authority) = split_target(method, target)
      let headers = List.map(header_lines, parse_header)
      let hosts = List.count(headers, fn(header) {
        let (name, _) = header
        name == "host"
      })
      case (hosts > 1, minor == 1 and hosts == 0) {
        (True, _) -> Failure(Refusal.Malformed("more than one host header"))
        (_, True) -> Failure(Refusal.Malformed("no host header"))
        _ -> Void
      }
      Parsed(method, path, query, minor, authority_as_host(headers, authority))
    }
  }
}

// Bytes a head never holds outside its CRLF line ends: controls other than
// HTAB, and DEL. Refusing them keeps a bare CR or a NUL from reaching a
// handler, which could echo it into a response header.
// A chunk line or trailer, refused when it holds a control character other
// than HTAB: a bare CR or LF in one could end the line early for a proxy.
fn refuse_controls(line: Bytes) -> Bytes {
  case List.any(Bytes.to_list(line), fn(byte) {
    is_control(byte) or byte == 10 or byte == 13
  }) {
    True -> Failure(Refusal.Malformed("a control character in a chunked body"))
    False -> line
  }
}

fn is_control(byte: Int) -> Bool {
  (byte < 32 and byte != 9 and byte != 10 and byte != 13) or byte == 127
}

fn parse_request_line(line: Text) -> (Method, Text, Int) {
  case Text.split(line, " ") {
    [name, target, version] -> {
      let minor = parse_version(version)
      case is_token(name) and (not Text.is_empty(target)) and is_visible(target) {
        True -> (method_named(name), target, minor)
        False -> Failure(Refusal.Malformed("bad request line"))
      }
    }
    _ -> Failure(Refusal.Malformed("bad request line"))
  }
}

// The minor version of `HTTP/1.x`; a later 1.x is read as 1.1 (RFC 9110
// section 6.2). Another major version is 505, and anything else 400.
fn parse_version(version: Text) -> Int {
  let bytes = Bytes.to_list(Bytes.from_text(version))
  case (Text.starts_with(version, "HTTP/"), bytes) {
    (True, [_, _, _, _, _, major, 46, minor]) -> case (is_digit(major) and is_digit(minor), major == 49) {
      (False, _) -> Failure(Refusal.Malformed("bad request line"))
      (True, False) -> Failure(Refusal.BadVersion)
      (True, True) -> smaller(minor - 48, 1)
    }
    _ -> Failure(Refusal.Malformed("bad request line"))
  }
}

fn is_visible(text: Text) -> Bool {
  List.all(Bytes.to_list(Bytes.from_text(text)), fn(byte) { byte > 32 and byte != 127 })
}

fn method_named(name: Text) -> Method {
  case name {
    "GET" -> Method.Get
    "HEAD" -> Method.Head
    "POST" -> Method.Post
    "PUT" -> Method.Put
    "PATCH" -> Method.Patch
    "DELETE" -> Method.Delete
    "OPTIONS" -> Method.Options
    other -> Method.Other(other)
  }
}

// The path segments, the query, and the authority of an absolute-form
// target (`http://host/path`, RFC 9112 section 3.2.2). `OPTIONS *` has the
// path `["*"]`.
fn split_target(method: Method, target: Text) -> (List<Text>, Text, Option<Text>) {
  case (method, target, absolute_target(target)) {
    (Method.Options, "*", _) -> (["*"], "", None)
    (_, _, Some((authority, origin))) -> case Text.is_empty(authority) {
      True -> Failure(Refusal.Malformed("an absolute target without a host"))
      False -> {
        let (path, query) = split_origin(origin)
        (path, query, Some(authority))
      }
    }
    _ -> case Text.starts_with(target, "/") {
      True -> {
        let (path, query) = split_origin(target)
        (path, query, None)
      }
      False -> Failure(Refusal.Malformed("bad request target"))
    }
  }
}

// `http://host/path?query` as `("host", "/path?query")`.
fn absolute_target(target: Text) -> Option<(Text, Text)> {
  let lowered = ascii_lowercase(target)
  let scheme = case (Text.starts_with(lowered, "http://"), Text.starts_with(lowered, "https://")) {
    (True, _) -> 7
    (_, True) -> 8
    _ -> 0
  }
  case scheme == 0 {
    True -> None
    False -> {
      let rest = drop_bytes(target, scheme)
      let (before_query, query) = case Text.split_once(rest, "?") {
        Some((before, after)) -> (before, "?${after}")
        None -> (rest, "")
      }
      case Text.split_once(before_query, "/") {
        Some((authority, path)) -> Some((authority, "/${path}${query}"))
        None -> Some((before_query, "/${query}"))
      }
    }
  }
}

fn split_origin(target: Text) -> (List<Text>, Text) {
  let (path, query) = case Text.split_once(target, "?") {
    Some((path, query)) -> (path, query)
    None -> (target, "")
  }
  (List.filter(Text.split(path, "/"), fn(segment) { not Text.is_empty(segment) }), query)
}

// An absolute-form target's authority replaces the host header (RFC 9112
// section 3.2.2).
fn authority_as_host(headers: List<(Text, Text)>, authority: Option<Text>) -> List<(Text, Text)> {
  case authority {
    None -> headers
    Some(host) -> List.push(List.filter(headers, fn(header) {
      let (name, _) = header
      name != "host"
    }), ("host", host))
  }
}

fn parse_header(line: Text) -> (Text, Text) {
  case Text.split_once(line, ":") {
    Some((name, value)) -> case is_token(name) {
      True -> (ascii_lowercase(name), trim_spaces(value))
      False -> Failure(Refusal.Malformed("bad header name"))
    }
    None -> Failure(Refusal.Malformed("a header line has no colon"))
  }
}

// A token (RFC 9110): one or more visible characters other than separators.
fn is_token(text: Text) -> Bool {
  let bytes = Bytes.to_list(Bytes.from_text(text))
  (not List.is_empty(bytes)) and List.all(bytes, is_token_byte)
}

fn is_token_byte(byte: Int) -> Bool {
  let alphanumeric = is_digit(byte) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)
  alphanumeric or List.contains([33, 35, 36, 37, 38, 39, 42, 43, 45, 46, 94, 95, 96, 124, 126], byte)
}

// 8. Reading bytes off the connection.

// Bytes read off the connection, of which those from `at` on are not yet
// used. Keeping a position, rather than slicing off what was used, keeps a
// buffer of pipelined requests from being copied once per request.
struct Cursor {
  bytes: Bytes,
  at: Int,
}

fn unread(cursor: Cursor) -> Int {
  Bytes.length(cursor.bytes) - cursor.at
}

fn rest_of(cursor: Cursor) -> Bytes {
  Bytes.slice(cursor.bytes, cursor.at..Bytes.length(cursor.bytes))
}

// The bytes of a head, without the blank line that ends it, and a cursor
// after it; `None` when the client closed the connection without starting
// another request.
fn read_head(reader: Reader<NetError>, cursor: Cursor, limit: Int) -> Option<(Bytes, Cursor)> {
  let start = start_of_request(reader, cursor, limit)
  case start {
    None -> None
    Some(start) -> Some(read_until(reader, start, Bytes.from_text("\r\n\r\n"), limit, Refusal.HeadTooLarge))
  }
}

// A cursor at the first byte of the next request, past any empty lines a
// client sends before it (RFC 9112 section 2.2), or `None` when the
// connection ends first.
fn start_of_request(reader: Reader<NetError>, cursor: Cursor, limit: Int) -> Option<Cursor> {
  loop state = (cursor, 0) {
    let (here, skipped) = state
    case (Bytes.get(here.bytes, here.at), Bytes.get(here.bytes, here.at + 1), skipped > limit) {
      (_, _, True) -> Failure(Refusal.HeadTooLarge)
      (None, _, _) -> {
        let chunk = Stream.read(reader)
        case chunk {
          Some(bytes) -> (Cursor(bytes, 0), skipped)
          None -> break None
        }
      }
      (Some(13), None, _) -> {
        let chunk = Stream.read(reader)
        case chunk {
          Some(bytes) -> (Cursor(Bytes.append(rest_of(here), bytes), 0), skipped)
          None -> break None
        }
      }
      (Some(13), Some(10), _) -> (Cursor(here.bytes, here.at + 2), skipped + 2)
      _ -> break Some(here)
    }
  }
}

// The bytes before the first `needle` and a cursor after it. The needle
// must start within `limit` bytes, or this fails with `too_long`. Each byte
// is searched at most a few times and copied at most twice, however the
// client splits its writes.
fn read_until(reader: Reader<NetError>, cursor: Cursor, needle: Bytes, limit: Int, too_long: Refusal) -> (Bytes, Cursor) {
  let width = Bytes.length(needle)
  case (limit < 0, find_unread(cursor, needle, limit + width)) {
    (True, _) -> Failure(too_long)
    // The search reaches only `limit + width` bytes, so a needle it finds
    // starts within the limit.
    (_, Some(at)) -> (Bytes.slice(cursor.bytes, cursor.at..(cursor.at + at)), Cursor(cursor.bytes, cursor.at + at + width))
    (_, None) -> case unread(cursor) >= limit + width {
      True -> Failure(too_long)
      False -> collect_until(reader, rest_of(cursor), needle, limit, too_long)
    }
  }
}

// Where `needle` starts in the first `reach` unread bytes, searching a
// window that doubles, so a short request at the front of a long buffer
// costs only its own length.
fn find_unread(cursor: Cursor, needle: Bytes, reach: Int) -> Option<Int> {
  let most = smaller(unread(cursor), reach)
  loop width = smaller(512, most) {
    let window = Bytes.slice(cursor.bytes, cursor.at..(cursor.at + width))
    case (Bytes.index_of(window, needle), width >= most) {
      (Some(at), _) -> break Some(at)
      (None, True) -> break None
      (None, False) -> smaller(width * 2, most)
    }
  }
}

// `read_until` once the buffered bytes, `first`, hold no needle: each read
// is searched together with the end of the bytes before it, and the parts
// are joined once.
fn collect_until(reader: Reader<NetError>, first: Bytes, needle: Bytes, limit: Int, too_long: Refusal) -> (Bytes, Cursor) {
  let width = Bytes.length(needle)
  loop state = ([first], Bytes.length(first), last_bytes(first, width - 1)) {
    let (parts, total, tail) = state
    let read = Stream.read(reader)
    case read {
      None -> Failure(Refusal.Malformed("the connection ended inside a request"))
      Some(chunk) -> {
        let probe = Bytes.append(tail, chunk)
        let grown = total + Bytes.length(chunk)
        case Bytes.index_of(probe, needle) {
          Some(at) -> {
            let start = total - Bytes.length(tail) + at
            case start > limit {
              True -> Failure(too_long)
              False -> {
                let all = Bytes.concat(List.push(parts, chunk))
                break (Bytes.slice(all, 0..start), Cursor(chunk, at + width - Bytes.length(tail)))
              }
            }
          }
          None -> case grown >= limit + width {
            True -> Failure(too_long)
            False -> (List.push(parts, chunk), grown, last_bytes(probe, width - 1))
          }
        }
      }
    }
  }
}

fn last_bytes(bytes: Bytes, count: Int) -> Bytes {
  let length = Bytes.length(bytes)
  Bytes.slice(bytes, larger(length - count, 0)..length)
}

// Exactly `count` bytes, and a cursor after them.
fn read_exact(reader: Reader<NetError>, cursor: Cursor, count: Int) -> (Bytes, Cursor) {
  case unread(cursor) >= count {
    True -> (Bytes.slice(cursor.bytes, cursor.at..(cursor.at + count)), Cursor(cursor.bytes, cursor.at + count))
    False -> collect_exact(reader, rest_of(cursor), count)
  }
}

fn collect_exact(reader: Reader<NetError>, first: Bytes, count: Int) -> (Bytes, Cursor) {
  loop state = ([first], Bytes.length(first)) {
    let (parts, total) = state
    let read = Stream.read(reader)
    case read {
      None -> Failure(Refusal.Malformed("the connection ended inside a body"))
      Some(chunk) -> {
        let grown = total + Bytes.length(chunk)
        case grown >= count {
          True -> {
            let used = count - total
            break (Bytes.concat(List.push(parts, Bytes.slice(chunk, 0..used))), Cursor(chunk, used))
          }
          False -> (List.push(parts, chunk), grown)
        }
      }
    }
  }
}

// A chunked body (RFC 9112 section 7.1), and a cursor after it. Its whole
// framing counts toward the body limit, so many tiny chunks or long
// extensions cannot make it cost more than a plain body; trailers count
// toward it too, and toward the header count. Extensions and trailers are
// dropped.
fn read_chunked(reader: Reader<NetError>, cursor: Cursor, bounds: Limits) -> (Bytes, Cursor) {
  let crlf = Bytes.from_text("\r\n")
  let limit = bounds.body_bytes
  loop state = ([], 0, cursor) {
    let (parts, used, here) = state
    let (line, after_line) = read_until(reader, here, crlf, smaller(1024, limit - used), Refusal.BodyTooLarge)
    let length = chunk_length(refuse_controls(line))
    let framed = used + Bytes.length(line) + 2
    case (length == 0, framed + length + 2 > limit) {
      (True, _) -> break (Bytes.concat(parts), skip_trailers(reader, after_line, limit - framed, bounds.header_count))
      (False, True) -> Failure(Refusal.BodyTooLarge)
      (False, False) -> {
        let (data, after_data) = read_exact(reader, after_line, length)
        let (ending, next) = read_exact(reader, after_data, 2)
        case ending == crlf {
          True -> (List.push(parts, data), framed + length + 2, next)
          False -> Failure(Refusal.Malformed("a chunk does not end in CRLF"))
        }
      }
    }
  }
}

fn skip_trailers(reader: Reader<NetError>, cursor: Cursor, budget: Int, count: Int) -> Cursor {
  let crlf = Bytes.from_text("\r\n")
  loop state = (cursor, budget, 0) {
    let (here, left, lines) = state
    let (found, next) = read_until(reader, here, crlf, left - 2, Refusal.BodyTooLarge)
    let line = refuse_controls(found)
    case (Bytes.is_empty(line), lines >= count) {
      (True, _) -> break next
      (False, True) -> Failure(Refusal.HeadTooLarge)
      (False, False) -> (next, left - Bytes.length(line) - 2, lines + 1)
    }
  }
}

// The size at the start of a chunk line, in hexadecimal, before any `;`
// extension.
fn chunk_length(line: Bytes) -> Int {
  let digits = case Bytes.split_once(line, Bytes.from_text(";")) {
    Some((size, _)) -> size
    None -> line
  }
  let values = Bytes.to_list(digits)
  case List.is_empty(values) or List.length(values) > 15 {
    True -> Failure(Refusal.Malformed("bad chunk size"))
    False -> List.reduce(values, 0, fn(total, byte) { total * 16 + hex_digit(byte) })
  }
}

fn hex_digit(byte: Int) -> Int {
  case (is_digit(byte), byte >= 97 and byte <= 102, byte >= 65 and byte <= 70) {
    (True, _, _) -> byte - 48
    (_, True, _) -> byte - 87
    (_, _, True) -> byte - 55
    _ -> Failure(Refusal.Malformed("bad chunk size"))
  }
}

// 9. Writing a response.

// Headers that frame the message or manage the connection, which the server
// writes itself.
fn is_framing_header(name: Text) -> Bool {
  List.contains(["content-length", "connection", "transfer-encoding", "te", "trailer", "upgrade", "keep-alive", "proxy-connection"], name)
}

fn write_response(writer: Writer<NetError>, response: Response, date: Text, keep_alive: Bool, minor: Int, head_only: Bool) -> Void {
  let given = List.filter(response.headers, fn(header) {
    let (name, _) = header
    not is_framing_header(name)
  })
  // RFC 9110 section 6.6.1: an origin server with a clock sends `Date`; a
  // handler's own `Date` stands.
  let dated = case find_header(response.headers, "date") {
    Some(_) -> []
    None -> [("date", date)]
  }
  // A 204 has no body to measure; a 304's length is that of the body it
  // stands for, which only the handler knows.
  let framing = case response.status {
    204 -> []
    304 -> case find_header(response.headers, "content-length") {
      Some(length) -> [("content-length", length)]
      None -> []
    }
    _ -> [("content-length", Int.to_text(Bytes.length(response.body)))]
  }
  let connection = case (keep_alive, minor) {
    (False, _) -> [("connection", "close")]
    (True, 0) -> [("connection", "keep-alive")]
    _ -> []
  }
  let lines = List.map(List.concat([given, dated, framing, connection]), fn(header) {
    let (name, value) = header
    "${name}: ${value}\r\n"
  })
  let head = Text.concat(List.concat([["HTTP/1.1 ${response.status} ${reason(response.status)}\r\n"], lines, ["\r\n"]]))
  let body = case head_only or response.status == 204 or response.status == 304 {
    True -> Bytes.empty()
    False -> response.body
  }
  Stream.write(writer, Bytes.append(Bytes.from_text(head), body))
}

// The current time as an HTTP date.
fn now() -> Text needs {
  clock: Clock
} {
  http_date(Clock.unix_nanoseconds(Clock.timestamp()))
}

// `nanoseconds` since 1970 as an IMF-fixdate (RFC 9110 section 5.6.7), such
// as `Sun, 06 Nov 1994 08:49:37 GMT`. The calendar is Howard Hinnant's
// `civil_from_days`, which holds for every proleptic Gregorian date.
fn http_date(nanoseconds: Int) -> Text {
  let seconds = floor_divide(nanoseconds, 1000000000)
  let days = floor_divide(seconds, 86400)
  let of_day = Int.modulo(seconds, 86400)
  let shifted = days + 719468
  let era = floor_divide(shifted, 146097)
  let of_era = shifted - era * 146097
  let year_of_era = (of_era - of_era / 1460 + of_era / 36524 - of_era / 146096) / 365
  let of_year = of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100)
  let shifted_month = (5 * of_year + 2) / 153
  let day = of_year - (153 * shifted_month + 2) / 5 + 1
  let month = case shifted_month < 10 {
    True -> shifted_month + 3
    False -> shifted_month - 9
  }
  let year = case month <= 2 {
    True -> year_of_era + era * 400 + 1
    False -> year_of_era + era * 400
  }
  let weekday = List.get(["Thu", "Fri", "Sat", "Sun", "Mon", "Tue", "Wed"], Int.modulo(days, 7))
  let month_name = List.get(["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"], month - 1)
  case (weekday, month_name) {
    (Some(weekday), Some(month_name)) -> "${weekday}, ${two(day)} ${month_name} ${Text.pad_start(Int.to_text(year), 4, "0")} ${two(of_day / 3600)}:${two(of_day / 60 % 60)}:${two(of_day % 60)} GMT"
    _ -> Debug.crash("Http: no calendar name for day ${days}")
  }
}

fn two(value: Int) -> Text {
  Text.pad_start(Int.to_text(value), 2, "0")
}

// `left / right` rounded toward negative infinity, for a positive `right`.
fn floor_divide(left: Int, right: Int) -> Int {
  (left - Int.modulo(left, right)) / right
}

fn refusal_response(refusal: Refusal) -> Response {
  case refusal {
    Refusal.Malformed(reason) -> text(400, "bad request: ${reason}")
    Refusal.HeadTooLarge -> text(431, "request header fields too large")
    Refusal.BodyTooLarge -> text(413, "content too large")
    Refusal.NotImplemented(reason) -> text(501, "not implemented: ${reason}")
    Refusal.BadVersion -> text(505, "http version not supported")
  }
}

fn reason(status: Int) -> Text {
  case status {
    200 -> "OK"
    201 -> "Created"
    202 -> "Accepted"
    204 -> "No Content"
    301 -> "Moved Permanently"
    302 -> "Found"
    303 -> "See Other"
    304 -> "Not Modified"
    307 -> "Temporary Redirect"
    308 -> "Permanent Redirect"
    400 -> "Bad Request"
    401 -> "Unauthorized"
    403 -> "Forbidden"
    404 -> "Not Found"
    405 -> "Method Not Allowed"
    409 -> "Conflict"
    413 -> "Content Too Large"
    422 -> "Unprocessable Content"
    429 -> "Too Many Requests"
    431 -> "Request Header Fields Too Large"
    500 -> "Internal Server Error"
    501 -> "Not Implemented"
    502 -> "Bad Gateway"
    503 -> "Service Unavailable"
    504 -> "Gateway Timeout"
    505 -> "HTTP Version Not Supported"
    _ -> "Status"
  }
}

// 10. Helpers.

fn find_header(headers: List<(Text, Text)>, name: Text) -> Option<Text> {
  List.find_map(headers, fn(header) {
    let (key, value) = header
    case key == name {
      True -> Some(value)
      False -> None
    }
  })
}

// The comma-separated items of every `name` header, joined, trimmed and in
// lowercase: `Connection: Keep-Alive, Upgrade` gives `["keep-alive", "upgrade"]`.
fn header_tokens(headers: List<(Text, Text)>, name: Text) -> List<Text> {
  List.flat_map(headers, fn(header) {
    let (key, value) = header
    case key == name {
      True -> List.filter(List.map(Text.split(ascii_lowercase(value), ","), trim_spaces), fn(item) {
        not Text.is_empty(item)
      })
      False -> []
    }
  })
}

fn lowercase_names(headers: List<(Text, Text)>) -> List<(Text, Text)> {
  List.map(headers, fn(header) {
    let (name, value) = header
    (ascii_lowercase(name), value)
  })
}

// Lowercases A to Z only. HTTP's names and tokens are ASCII, and Unicode
// lowercasing would turn the Kelvin sign into `k`, so `chunKed` with one
// would read as `chunked` here and as something else to a proxy.
fn ascii_lowercase(text: Text) -> Text {
  let lowered = List.map(Bytes.to_list(Bytes.from_text(text)), fn(byte) {
    case byte >= 65 and byte <= 90 {
      True -> byte + 32
      False -> byte
    }
  })
  Bytes.to_text_lossy(Bytes.from(lowered))
}

// Trims spaces and tabs only, the whitespace HTTP allows around a value.
fn trim_spaces(text: Text) -> Text {
  let bytes = Bytes.from_text(text)
  let values = Bytes.to_list(bytes)
  let is_space = fn(byte) { byte == 32 or byte == 9 }
  case List.find_index(values, fn(byte) { not is_space(byte) }) {
    None -> ""
    Some(start) -> {
      let from_end = case List.find_index(List.reverse(values), fn(byte) { not is_space(byte) }) {
        Some(count) -> count
        None -> 0
      }
      Bytes.to_text_lossy(Bytes.slice(bytes, start..(List.length(values) - from_end)))
    }
  }
}

fn drop_bytes(text: Text, count: Int) -> Text {
  let bytes = Bytes.from_text(text)
  Bytes.to_text_lossy(Bytes.slice(bytes, count..Bytes.length(bytes)))
}

fn smaller(left: Int, right: Int) -> Int {
  case left < right {
    True -> left
    False -> right
  }
}

fn larger(left: Int, right: Int) -> Int {
  case left > right {
    True -> left
    False -> right
  }
}

fn checked_header(header: (Text, Text)) -> (Text, Text) {
  let (name, value) = header
  let controls = List.any(Bytes.to_list(Bytes.from_text(value)), fn(byte) { (byte < 32 and byte != 9) or byte == 127 })
  case (is_token(name), controls) {
    (False, _) -> Debug.crash("Http: the header name \"${name}\" is not a token")
    (_, True) -> Debug.crash("Http: the value of the header ${name} holds a control character")
    _ -> (ascii_lowercase(name), value)
  }
}

fn checked_status(status: Int) -> Int {
  case status >= 200 and status <= 599 {
    True -> status
    False -> Debug.crash("Http: the status ${status} is outside 200 to 599")
  }
}
