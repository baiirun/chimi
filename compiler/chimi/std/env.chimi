/// The program's environment: its environment variables and its working
/// directory. Reading them needs the `environment: Environment` capability,
/// which the runner supplies to `main` and a test supplies with `using`, so a
/// function's signature says when it reads the environment and a test can
/// fix what it sees.
///
/// ```text
/// pub fn main() -> Void needs { environment: Environment, console: Console } {
///   let home = Option.unwrap_or(Env.get("HOME"), "/")
///   console.write_line(home)
/// }
/// ```
///
/// There is no way to set a variable: the environment is shared by the whole
/// process, and a child process gets its own variables from `std/exec`.
/// Program arguments are `main`'s parameter, not part of this module.

import std/list as List
import std/map as Map
import std/map.{Map}
import std/path.{Path}

// 1. Public types.

/// The capability to read the environment. The runner's provider reads the
/// operating system's; a test's fake is a record of these two functions.
pub interface Environment {
  /// Every variable as a name and value pair, in the order the operating
  /// system keeps them. A variable whose name or value is not UTF-8 is left
  /// out.
  variables: fn() -> List<(Text, Text)>
  /// The working directory, or `None` when the process has none it can name
  /// (it was removed, or its path is not UTF-8).
  current_directory: fn() -> Option<Path>
}

// 2. Failure types.

/// Failures of `Env.current_directory`.
pub enum EnvError {
  /// The working directory was removed, cannot be read, or its path is not
  /// UTF-8.
  NoCurrentDirectory
}

// 5. Queries.

/// Returns the value of the variable `name`, or `None` when it is not set.
/// Names are case-sensitive.
///
/// Cost: O(n) in the number of variables.
pub fn get(name: Text) -> Option<Text> needs {
  environment: Environment
} {
  List.find_map(environment.variables(), fn(variable) {
    let (key, value) = variable
    case key == name {
      True -> Some(value)
      False -> None
    }
  })
}

/// Returns every variable by name. When the operating system holds a name
/// twice, the first value wins, as `get` and C's `getenv` read it.
///
/// Cost: O(n log n) in the number of variables.
pub fn all() -> Map<Text, Text> needs {
  environment: Environment
} {
  List.reduce(List.reverse(environment.variables()), Map.empty(), fn(variables, variable) {
    let (key, value) = variable
    Map.put(variables, key, value)
  })
}

/// Returns the working directory, the directory relative paths start from.
///
/// Fails with: `EnvError.NoCurrentDirectory`.
/// Cost: one system call.
pub fn current_directory() -> Path needs {
  environment: Environment
} {
  case environment.current_directory() {
    Some(path) -> path
    None -> Failure(EnvError.NoCurrentDirectory)
  }
}

// 8. Runner provider.

// The provider the runner binds to `main`'s `environment` need
// (operations.rs `RUNNER_PROVIDERS`). Private, so no other code can take the
// capability without declaring the need.
fn host() {
  {
    variables: host_variables, current_directory: host_current_directory
  }
}

native fn host_variables() -> List<(Text, Text)>

native fn host_current_directory() -> Option<Path>
