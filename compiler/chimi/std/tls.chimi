/// TLS over any `Net.Connection`. `Tls.client` and `Tls.server` take an
/// open connection, finish the handshake, and give back a connection whose
/// streams carry plaintext, so code written for `Net.Connection` (std/http,
/// std/sql) runs over either kind. `Tls.listener` wraps a listener, so
/// `Http.serve(Tls.listener(listener, identity), Http.defaults, handle)` is
/// an HTTPS server.
///
/// ```text
/// pub fn main() -> Void needs { network: Network } {
///   Resource.scoped(fn() { Tls.client(Net.connect("example.com", 443), "example.com", Tls.defaults) }, Net.close, fn(connection) {
///     Stream.write(Net.writer(connection), Bytes.from_text("GET / HTTP/1.0\r\nHost: example.com\r\n\r\n"))
///     Stream.read_all(Net.reader(connection), 1048576)
///   })
/// }
/// ```
///
/// A client always checks the server's certificate against its trusted roots
/// and the host name; there is no way to turn the check off. `Tls.defaults`
/// trusts the system's roots: the file `SSL_CERT_FILE` names, else the usual
/// bundle paths. A test trusts its own fixture authority with
/// `{ ..Tls.defaults, roots: Tls.roots(pem) }`. A server proves itself with an
/// `Identity` made from a PEM certificate chain and its unencrypted PEM key.
///
/// TLS 1.2 and 1.3 are offered, through mbedTLS 4.1 (vendored under
/// `runtime/native/bindings/tls/`). Closing the writer sends `close_notify`
/// before it closes the inner writer; a peer that ends its stream without
/// `close_notify` fails the read with `NetError.Failed`, since the data may
/// have been cut short. `Net.close` releases the session and the inner
/// connection.
///
/// Encryption runs in memory and the wrapper moves bytes through the inner
/// connection's streams, so a TLS connection waits wherever its inner
/// connection waits, and a fake from `Net.pair` works the same as a socket.

import std/bytes as Bytes.{Bytes}
import std/net as Net.{Connection, Listener, NetError}
import std/resource as Resource
import std/result as Result.{Err, Ok, Result}
import std/stream as Stream
import std/watch as Watch
import std/channel.{Receive}

// 1. Public types.

/// The certificate authorities a client trusts: the system's (in
/// `Tls.defaults`) or a PEM bundle from `Tls.roots`.
pub struct Roots {
  pem: Option<Bytes>,
}

/// A server's certificate chain and private key, from `Tls.identity`.
pub struct Identity {
  certificate: Bytes,
  key: Bytes,
}

// 2. Failure types.

/// Why a TLS handshake, or making its settings, failed.
pub enum TlsError {
  /// The server's certificate does not chain to a trusted root.
  Untrusted
  /// The server's certificate is expired or not yet valid.
  Expired
  /// The server's certificate is for another host than `host`.
  WrongHost(host: Text)
  /// The two sides share no TLS version or cipher.
  Unacceptable(reason: Text)
  /// The client trusts the system's roots, and none were found.
  NoRoots
  /// The handshake failed some other way, with mbedTLS's words: a peer that
  /// is not speaking TLS, an alert from the peer, or a connection that ended
  /// part way.
  Handshake(message: Text)
  /// A certificate, key or host name is not usable.
  Invalid(message: Text)
}

// 3. Settings.

/// A client's settings: start from these and name what differs, as
/// `{ ..Tls.defaults, roots: Tls.roots(pem) }`. The default roots are the
/// system's.
pub const defaults: { roots: Roots } = { roots: Roots(None) }

/// Roots that trust exactly the certificates in `pem`, one or more PEM
/// `CERTIFICATE` blocks.
///
/// Fails with: `TlsError.Invalid` when `pem` holds no certificate mbedTLS
/// can parse.
/// Cost: O(n) in the size of `pem`, parsed once here and again per client.
pub fn roots(pem: Bytes) -> Roots {
  let _ = tls(native_check_roots(pem), "")
  Roots(Some(pem))
}

/// A server identity: a PEM certificate chain, leaf first, and the leaf's
/// unencrypted PEM private key.
///
/// Fails with: `TlsError.Invalid` when either does not parse or the key does
/// not match the certificate.
pub fn identity(certificate: Bytes, key: Bytes) -> Identity {
  tls(native_check_identity(certificate, key), "")
  Identity(certificate, key)
}

// 4. Wrapping a connection.

/// The client end of a TLS connection over `connection`, to the server
/// named `host`, once the handshake is done. `host` is checked against the
/// server's certificate and sent as the server name (SNI).
///
/// Fails with: `TlsError.Untrusted`, `Expired`, `WrongHost`, `Unacceptable`,
/// `NoRoots`, `Handshake` or `Invalid`, and what the inner connection's
/// streams fail with. On a failure the inner connection is left open, for
/// the caller that opened it to close.
pub fn client(connection: Connection, host: Text, settings: { roots: Roots }) -> Connection {
  secured(connection, host, fn() {
    case settings.roots.pem {
      Some(pem) -> tls(native_client(pem, host), host)
      None -> tls(native_client_system(host), host)
    }
  })
}

/// The server end of a TLS connection over `connection`, proving itself
/// with `identity`, once the handshake is done.
///
/// Fails with: `TlsError.Unacceptable`, `Handshake` or `Invalid`, and what
/// the inner connection's streams fail with. On a failure the inner
/// connection is left open.
pub fn server(connection: Connection, identity: Identity) -> Connection {
  secured(connection, "", fn() {
    tls(native_server(identity.certificate, identity.key), "")
  })
}

/// A listener whose connections are the server ends of TLS connections
/// over those `listener` accepts, proving the server with `identity`. So
/// `Http.serve(Tls.listener(listener, identity), Http.defaults, handle)`
/// serves HTTPS.
///
/// Accepting does not wait for the client: the handshake runs on the
/// connection's first read or write, in whatever task serves it, so a slow
/// or silent client holds only its own connection, under that task's
/// timeouts, never the accept loop (as Go's `tls.NewListener` does). A
/// handshake that fails there fails the read or write with
/// `NetError.Failed`, naming what went wrong, or with the accepted
/// connection's own `NetError`, and every later read or write fails the
/// same way; after the handshake the connection behaves as one from
/// `Tls.server`. While one task drives the handshake, a read or write from
/// another waits for it. Closing the listener closes `listener`.
///
/// Fails with (from `Net.accept`): what `listener` fails with, and
/// `NetError.Failed` when the session cannot be made; the accepted
/// connection is then closed.
/// Cost: O(1) to make; each accept parses `identity` again.
pub fn listener(listener: Listener, identity: Identity) -> Listener {
  Net.listener(fn() {
    let accepted = Net.accept(listener)
    case native_server(identity.certificate, identity.key) {
      Ok(session) -> deferred(accepted, session)
      Err((_, message)) -> {
        Net.close(accepted)
        Failure(NetError.Failed("TLS: ${message}"))
      }
    }
  }, Net.listener_address(listener), fn() { Net.close_listener(listener) })
}

/// How many TLS sessions this program holds: made, and not yet freed. A
/// session is freed by `Net.close`, and a `Tls.client` or `Tls.server`
/// session also by a failed handshake. For tests that check nothing leaks.
/// Test-only (`T4401`).
pub fn live_sessions_for_tests() -> Int {
  native_live_sessions()
}

// 5. The session over the inner connection.

// The session is made and handshaken inside Resource.scoped, so it is freed
// however the handshake ends (a failure, a cancel, a timeout), and handed to
// a handle of its own once the handshake is done.
fn secured(connection: Connection, host: Text, start: fn() -> TlsSession errors TlsError | NetError) -> Connection {
  let session = Resource.scoped(start, native_free, fn(starting) {
    handshake(connection, starting, host)
    tls(native_handoff(starting), host)
  })
  Net.connection(
    Stream.reader(fn() { receive(connection, session) }, fn() { Stream.stop(Net.reader(connection)) }),
    Stream.writer(fn(bytes) { send(connection, session, bytes) }, fn() { finish(connection, session) }),
    Net.local_address(connection),
    Net.peer_address(connection),
    fn() {
      native_free(session)
      Net.close(connection)
    },
  )
}

// A server connection whose handshake runs on its first read or write. A
// finished handshake answers at once, so later calls cost a few checks.
// `turns` counts the times a task gave up driving the handshake, so a task
// that found another driving it waits for that one to finish instead of
// reading the inner connection beside it.
fn deferred(connection: Connection, session: TlsSession) -> Connection {
  let turns = Watch.starting_with(0).publisher
  Net.connection(
    Stream.reader(fn() {
      settle(connection, session, turns)
      receive(connection, session)
    }, fn() { Stream.stop(Net.reader(connection)) }),
    Stream.writer(fn(bytes) {
      settle(connection, session, turns)
      send(connection, session, bytes)
    }, fn() { finish(connection, session) }),
    Net.local_address(connection),
    Net.peer_address(connection),
    fn() {
      native_free(session)
      Net.close(connection)
    },
  )
}

// The handshake of a deferred connection, driven by one task at a time and
// failing as a connection does. The claim is given back however the drive
// ends, a cancel or a timeout included, so a waiting task can take over.
fn settle(connection: Connection, session: TlsSession, turns: Watch.Publisher<Int>) -> Void {
  loop _waiting = True {
    let seen = turn(turns)
    case native_claim(session) {
      True -> break Resource.scoped(fn() { Void }, fn(_) {
        native_unclaim(session)
        // Past the current count, not `seen`: only the holder of the claim
        // publishes, so the count it reads now is the latest one.
        let _ = Result.capture(fn() { Watch.publish(turns, turn(turns) + 1) })
        Void
      }, fn(_) { drive(connection, session) })
      False -> {
        next_turn(turns, seen)
        True
      }
    }
  }
}

fn turn(turns: Watch.Publisher<Int>) -> Int {
  case Result.capture(fn() { Watch.receive(Watch.subscribe(turns)) }) {
    Ok(Receive.Received(count)) -> count
    _ -> 0
  }
}

// Waits until `turns` has moved past `seen`, or its watch has gone.
fn next_turn(turns: Watch.Publisher<Int>, seen: Int) -> Void {
  let _ = Result.capture(fn() {
    let follower = Watch.subscribe(turns)
    loop _waiting = True {
      let received = Watch.receive(follower)
      case received {
        Receive.Received(count) -> case count == seen {
          True -> True
          False -> break Void
        }
        _ -> break Void
      }
    }
  })
  Void
}

fn drive(connection: Connection, session: TlsSession) -> Void {
  case Result.capture(fn() { handshake(connection, session, "") }) {
    Ok(_) -> Void
    Err(TlsError.Untrusted) -> failed("the client's certificate is not trusted")
    Err(TlsError.Expired) -> failed("the client's certificate has expired")
    Err(TlsError.WrongHost(_)) -> failed("the client's certificate is for another host")
    Err(TlsError.Unacceptable(reason)) -> failed(reason)
    Err(TlsError.NoRoots) -> failed("no trusted roots")
    Err(TlsError.Handshake(message)) -> failed(message)
    Err(TlsError.Invalid(message)) -> failed(message)
    Err(NetError.Refused) -> Failure(NetError.Refused)
    Err(NetError.Unreachable) -> Failure(NetError.Unreachable)
    Err(NetError.Reset) -> Failure(NetError.Reset)
    Err(NetError.Closed) -> Failure(NetError.Closed)
    Err(NetError.AddressInUse) -> Failure(NetError.AddressInUse)
    Err(NetError.HostNotFound(host)) -> Failure(NetError.HostNotFound(host))
    Err(NetError.TooManyOpen) -> Failure(NetError.TooManyOpen)
    Err(NetError.TimedOut) -> Failure(NetError.TimedOut)
    Err(NetError.Failed(message)) -> Failure(NetError.Failed(message))
  }
}

fn failed(message: Text) -> Void {
  Failure(NetError.Failed("TLS: the handshake failed: ${message}"))
}

// A failed step still sends what the session queued (an alert telling the
// peer why), as far as the connection allows.
fn handshake(connection: Connection, session: TlsSession, host: Text) -> Void {
  loop _ = Void {
    let step = native_handshake(session)
    case step {
      Ok(_) -> flush(connection, session)
      Err(_) -> {
        let _ = Result.capture(fn() { flush(connection, session) })
        Void
      }
    }
    let done = tls(step, host)
    case done {
      True -> break Void
      False -> {
        let next = Stream.read(Net.reader(connection))
        case next {
          Some(bytes) -> tls(native_feed(session, bytes), host)
          None -> Failure(TlsError.Handshake("the peer ended the connection during the handshake"))
        }
      }
    }
  }
}

fn receive(connection: Connection, session: TlsSession) -> Option<Bytes> {
  loop _ = Void {
    let (status, bytes) = net(native_receive(session))
    case status {
      0 -> break Some(bytes)
      2 -> break None
      _ -> {
        let next = Stream.read(Net.reader(connection))
        case next {
          Some(more) -> net(native_feed(session, more))
          None -> Failure(NetError.Failed("TLS: the peer ended the connection without close_notify"))
        }
      }
    }
  }
}

fn send(connection: Connection, session: TlsSession, bytes: Bytes) -> Void {
  net(native_send(session, bytes))
  flush(connection, session)
}

fn finish(connection: Connection, session: TlsSession) -> Void {
  native_close_notify(session)
  flush(connection, session)
  Stream.close(Net.writer(connection))
}

fn flush(connection: Connection, session: TlsSession) -> Void {
  let pending = native_take(session)
  let empty = Bytes.is_empty(pending)
  case empty {
    True -> Void
    False -> Stream.write(Net.writer(connection), pending)
  }
}

// The binding's failure codes (runtime/native/bindings/tls/tls_session.h).
// `host` names the server for `WrongHost`.
fn tls<T>(result: Result<T, (Int, Text)>, host: Text) -> T {
  case result {
    Ok(value) -> value
    Err((1, _)) -> Failure(TlsError.Untrusted)
    Err((2, _)) -> Failure(TlsError.Expired)
    Err((3, _)) -> Failure(TlsError.WrongHost(host))
    Err((4, message)) -> Failure(TlsError.Unacceptable(message))
    Err((5, message)) -> Failure(TlsError.Handshake(message))
    Err((7, _)) -> Failure(NetError.Closed)
    Err((8, _)) -> Failure(TlsError.NoRoots)
    Err((_, message)) -> Failure(TlsError.Invalid(message))
  }
}

// After the handshake a connection fails only with `NetError`, as any
// `Net.Connection` does.
fn net<T>(result: Result<T, (Int, Text)>) -> T {
  case result {
    Ok(value) -> value
    Err((7, _)) -> Failure(NetError.Closed)
    Err((_, message)) -> Failure(NetError.Failed("TLS: ${message}"))
  }
}

native type TlsSession

native fn native_client(roots: Bytes, host: Text) -> Result<TlsSession, (Int, Text)>
native fn native_client_system(host: Text) -> Result<TlsSession, (Int, Text)>
native fn native_server(certificate: Bytes, key: Bytes) -> Result<TlsSession, (Int, Text)>
native fn native_check_roots(pem: Bytes) -> Result<Int, (Int, Text)>
native fn native_check_identity(certificate: Bytes, key: Bytes) -> Result<Void, (Int, Text)>
native fn native_handshake(session: TlsSession) -> Result<Bool, (Int, Text)>
native fn native_feed(session: TlsSession, bytes: Bytes) -> Result<Void, (Int, Text)>
native fn native_take(session: TlsSession) -> Bytes
native fn native_send(session: TlsSession, bytes: Bytes) -> Result<Void, (Int, Text)>
native fn native_receive(session: TlsSession) -> Result<(Int, Bytes), (Int, Text)>
native fn native_close_notify(session: TlsSession) -> Void
native fn native_handoff(session: TlsSession) -> Result<TlsSession, (Int, Text)>
native fn native_claim(session: TlsSession) -> Bool
native fn native_unclaim(session: TlsSession) -> Void
native fn native_free(session: TlsSession) -> Void
native fn native_live_sessions() -> Int
