import std/io as IO
import std/io.{Console}
import std/io.{FileSystem}
import std/json as Json
import std/json.{Value}
import std/map as Map
import std/map.{Map}

enum UsageError {
  MissingPath
}

pub fn main(arguments: List<Text>) -> Void
  needs {
    files: FileSystem,
    console: Console,
  }
  effects { io } {
  case List.first(arguments) {
    Some(path) -> {
      let processed = files.process_utf8_lines(IO.path(path), Map.empty(), fn(state: Map<Text, Value>, line: Text) {
        case line {
          "" -> state
          _ -> {
            let decoded = Json.decode(line)
            console.write_line(line)
            Map.put(state, "last", decoded)
          }
        }
      })
      console.write_error("processed input")
    }
    None -> Failure(MissingPath())
  }
}
