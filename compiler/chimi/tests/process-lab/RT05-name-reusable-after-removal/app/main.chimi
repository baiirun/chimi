import std/channel as Channel
import std/channel.{Receive, Sender}
import std/duration as Duration
import std/process as Process
import std/process.{Inbox}
import std/supervisor as Supervisor

// RT05: a dynamic member registers `counter` and is removed. A new dynamic
// member then registers `counter` again, which only succeeds if the removal
// released the name, and named sends reach the new process: it counts Add(7)
// and reports 7.

pub enum Message {
  Add(amount: Int)
  Report(reply: Sender<Int>)
}

fn count_messages(inbox: Inbox<Message>) -> Void {
  loop total = 0 {
    case Process.receive(inbox) {
      Message.Add(amount) -> total + amount
      Message.Report(reply) -> {
        Channel.send(reply, total)
        total
      }
    }
  }
}

pub process name counter: Message

fn ask() -> Int {
  let replies = Channel.bounded(1)
  Process.send(counter, Message.Report(replies.sender))
  let reply = Channel.receive(replies.receiver)
  case reply {
    Receive.Received(value) -> value
    Receive.Drained -> -1
  }
}

pub fn main() -> Int {
  let root = Supervisor.start(Supervisor.policy([], 2, Supervisor.restarts(0, Duration.seconds(30))))
  let spec = Process.spec(count_messages, 2, Duration.seconds(1)) |> Process.register(counter)
  let first = Supervisor.start_process(root, spec, Supervisor.Restart.Never)
  Supervisor.remove_process(root, first)
  let second = Supervisor.start_process(root, spec, Supervisor.Restart.Never)
  Process.send(counter, Message.Add(7))
  let total = ask()
  Supervisor.stop(root)
  total
}
