// MF05: a program that uses tasks and no processes, so it links the
// scheduler. A child task runs a loop of N passes, each of which allocates a
// list it drops. Loops reclaim every pass in every tier, so the peak live
// bytes are the same for N = 10,000 and N = 1,000,000. Equality alone would
// also accept reclaiming every k-th pass, so expected.memory also bounds the
// peak at 7 KiB: one pass allocates about 1.7 KB, and survivors may grow by
// REGION_FULL_MIN_GROWTH (4 KiB) before a full pass. Per-pass reclamation
// peaks at 6,088 bytes; reclaiming every second pass peaks at 7,776.
import std/int as Int
import std/task as Task
import std/list as List

struct Pass {
  left: Int,
  total: Int,
}

fn churn(passes: Int) -> Int {
  loop state = Pass { left: passes, total: 0 } {
    case state.left {
      0 -> break state.total
      _ -> {
        let garbage = [state.left, state.total, state.left + state.total]
        Pass {
          left: state.left - 1,
          total: state.total + List.length(garbage) - 2,
        }
      }
    }
  }
}

pub fn main(arguments: List<Text>) -> Int {
  let passes = case List.first(arguments) {
    Some(text) -> Int.parse(text)
    None -> 0
  }
  let child = Task.start(fn() -> Int { churn(passes) })
  Task.result(child)
}
