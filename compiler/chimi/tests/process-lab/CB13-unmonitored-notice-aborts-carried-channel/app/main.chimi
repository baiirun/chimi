import std/channel as Channel
import std/channel.{Receive, Receiver, Sender}
import std/clock as Clock
import std/clock.{Clock}
import std/debug as Debug
import std/duration as Duration
import std/process as Process
import std/process.{Address, Down, Inbox}
import std/supervisor as Supervisor

// CHI-227: a monitor notice carries what it captures as a message does. The
// watcher gets `data`'s Receiver, captures it in a monitor's notice, then
// unmonitors, which drops the notice unread. The Receiver ends with it and
// aborts `data`, so main's send fails with Aborted (1). Before, the Receiver
// stayed with the still-running watcher and the send was accepted (0).

pub enum Job {
  Wait
}

pub enum Watch {
  Begin(worker: Address<Job>, source: Receiver<Int>, done: Sender<Int>)
  Gone(down: Down, source: Receiver<Int>)
}

pub process name worker: Job
pub process name watcher: Watch

fn work(inbox: Inbox<Job>) -> Void {
  case Process.receive(inbox) {
    Job.Wait -> Void
  }
}

fn watch(inbox: Inbox<Watch>) -> Void needs { clock: Clock } {
  case Process.receive(inbox) {
    Watch.Begin(target, source, done) -> {
      let monitor = Process.monitor(inbox, target, fn(down) { Watch.Gone(down, source) })
      Process.unmonitor(inbox, monitor)
      Channel.send(done, 1)
      Clock.sleep(Duration.seconds(60))
    }
    Watch.Gone(_, _) -> Debug.crash("unexpected notice")
  }
}

pub fn main() -> Int needs { clock: Clock } {
  let working = Process.spec(work, 1, Duration.seconds(1))
    |> Process.register(worker)
    |> Supervisor.process(Supervisor.Restart.Never)
  let watching = Process.spec(watch, 1, Duration.seconds(1))
    |> Process.register(watcher)
    |> Supervisor.process(Supervisor.Restart.Never)
  let root = Supervisor.start(Supervisor.policy([working, watching], 2, Supervisor.restarts(0, Duration.seconds(30))))
  let data = Channel.bounded(1)
  let done = Channel.bounded(1)
  Process.send(watcher, Watch.Begin(worker, data.receiver, done.sender))
  let _ = Channel.receive(done.receiver)
  let written = case Channel.send(data.sender, 5) {
    Success(_) -> 0
    Failure(_) -> 1
  }
  Supervisor.stop(root)
  written
}
