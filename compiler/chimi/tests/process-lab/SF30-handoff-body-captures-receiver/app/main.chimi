import std/channel as Channel.{Receiver}
import std/duration as Duration
import std/process as Process.{HandoffSpec, Inbox}

enum Message {
  Stop
}

fn handler(log: Receiver<Int>) -> HandoffSpec<Int, Message, Never> {
  Process.handoff_spec(fn(inbox: Inbox<Message>, limit: Int) -> Void {
    Channel.abort(log)
  }, 4, Duration.seconds(1))
}

pub fn main() -> Int {
  0
}
