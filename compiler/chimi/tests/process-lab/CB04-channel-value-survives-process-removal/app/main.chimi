import std/channel as Channel
import std/channel.{Receive, Sender}
import std/clock as Clock
import std/clock.{Clock}
import std/duration as Duration
import std/process as Process
import std/process.{Inbox}
import std/supervisor as Supervisor

// CB04: a process builds a `Payload` in its own heap and puts it on a buffered
// channel. Main removes the process, which destroys that heap, before it
// receives. The received value is intact (seed 7 gives 14 and 21), because
// the channel holds its own copy. No fragment outlives the run
// (expected.memory).

pub struct Payload {
  doubled: Int,
  tripled: Int,
}

pub enum Message {
  Make(seed: Int, reply: Sender<Payload>)
}

fn make(inbox: Inbox<Message>) -> Void {
  loop made = 0 {
    case Process.receive(inbox) {
      Message.Make(seed, reply) -> {
        Channel.send(reply, Payload(seed * 2, seed * 3))
        made + 1
      }
    }
  }
}

fn settle() -> Void needs { clock: Clock } {
  Clock.sleep(Duration.milliseconds(1))
}

pub fn main() -> Payload needs { clock: Clock } {
  let root = Supervisor.start(Supervisor.policy([], 1, Supervisor.restarts(0, Duration.seconds(30))))
  let managed = Supervisor.start_process(root, Process.spec(make, 1, Duration.seconds(1)), Supervisor.Restart.Never)
  let replies = Channel.bounded(1)
  Process.send(Supervisor.address(managed), Message.Make(7, replies.sender))
  settle()
  Supervisor.remove_process(root, managed)
  let received = Channel.receive(replies.receiver)
  let payload = case received {
    Receive.Received(value) -> value
    Receive.Drained -> Payload(0, 0)
  }
  Supervisor.stop(root)
  payload
}
