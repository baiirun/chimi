import std/channel as Channel
import std/channel.{Receive, Sender}
import std/duration as Duration
import std/process as Process
import std/process.{Inbox, SendError}
import std/supervisor as Supervisor

// MB13: capacity 3. Main fills the mailbox before `meter` runs, and a fourth
// send is `Full`. On its first message `meter` reads its backlog: 2 still
// queued (the message it took no longer counts) and capacity 3, and reports
// 2 * 10 + 3. Main adds 100 for the `Full`. Outcome 123.
pub enum Message {
  Note(value: Int)
  Report(reply: Sender<Int>)
}

pub process name meter: Message

fn measure(inbox: Inbox<Message>) -> Void {
  loop seen = -1 {
    case Process.receive(inbox) {
      Message.Note(_) -> case seen < 0 {
        True -> Process.queued(inbox) * 10 + Process.capacity(inbox)
        False -> seen
      }
      Message.Report(reply) -> {
        Channel.send(reply, seen)
        break
      }
    }
  }
}

pub fn main() -> Int {
  let member = Process.spec(measure, 3, Duration.seconds(1))
    |> Process.register(meter)
    |> Supervisor.process(Supervisor.Restart.Never)
  let root = Supervisor.start(Supervisor.policy([member], 1, Supervisor.restarts(0, Duration.seconds(30))))
  let replies = Channel.bounded(1)
  Process.send(meter, Message.Note(1))
  Process.send(meter, Message.Note(2))
  Process.send(meter, Message.Report(replies.sender))
  let full = case Process.send(meter, Message.Note(3)) {
    Success(_) -> 0
    Failure(error) -> case error {
      SendError.Full(_) -> 100
      SendError.Unavailable(_) -> -1000
    }
  }
  let received = Channel.receive(replies.receiver)
  let seen = case received {
    Receive.Received(value) -> value
    Receive.Drained -> -1
  }
  Supervisor.stop(root)
  full + seen
}
