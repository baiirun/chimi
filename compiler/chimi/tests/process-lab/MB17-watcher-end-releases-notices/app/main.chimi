import std/clock as Clock
import std/clock.{Clock}
import std/duration as Duration
import std/process as Process
import std/process.{Address, Down, Inbox}
import std/supervisor as Supervisor

// MB17: `watcher` monitors `worker` and the name `absent` (whose
// `Unavailable` notice is queued at once), then returns without receiving.
// The queued notice and the live monitor end with the watcher; when `worker`
// ends later, no notice is delivered anywhere. No fragment outlives the run
// (expected.memory): a notice left in the kernel would stay live.
pub enum Job {
  Return
}

pub enum Watch {
  Begin(worker: Address<Job>)
  Gone(down: Down)
}

pub process name worker: Job
pub process name absent: Job
pub process name watcher: Watch

fn work(inbox: Inbox<Job>) -> Void {
  case Process.receive(inbox) {
    Job.Return -> Void
  }
}

fn watch(inbox: Inbox<Watch>) -> Void {
  case Process.receive(inbox) {
    Watch.Begin(target) -> {
      Process.monitor(inbox, target, fn(down) { Watch.Gone(down) })
      Process.monitor(inbox, absent, fn(down) { Watch.Gone(down) })
      Void
    }
    Watch.Gone(_) -> Void
  }
}

fn settle() -> Void needs { clock: Clock } {
  Clock.sleep(Duration.milliseconds(1))
}

pub fn main() -> Int needs { clock: Clock } {
  let working = Process.spec(work, 1, Duration.seconds(1))
    |> Process.register(worker)
    |> Supervisor.process(Supervisor.Restart.Never)
  let watching = Process.spec(watch, 2, Duration.seconds(1))
    |> Process.register(watcher)
    |> Supervisor.process(Supervisor.Restart.Never)
  let root = Supervisor.start(Supervisor.policy([working, watching], 2, Supervisor.restarts(0, Duration.seconds(30))))
  Process.send(watcher, Watch.Begin(worker))
  settle()
  Process.send(worker, Job.Return)
  settle()
  Supervisor.stop(root)
  17
}
