import std/channel as Channel
import std/channel.{Receive, Sender}
import std/clock as Clock
import std/clock.{Clock}
import std/duration as Duration
import std/process as Process
import std/process.{Address, Inbox, SendError}
import std/supervisor as Supervisor

// OB01: a program with two workers, sends of every outcome, a stale direct
// address, and a stop. Under --trace=off it writes no telemetry and builds no
// trace event at all (expected.memory). The outcome is 3: worker_a's total
// (1 + 2).

pub enum Message {
  Add(amount: Int)
  Report(reply: Sender<Int>)
}

fn counter(inbox: Inbox<Message>) -> Void {
  loop total = 0 {
    case Process.receive(inbox) {
      Message.Add(amount) -> total + amount
      Message.Report(reply) -> {
        Channel.send(reply, total)
        total
      }
    }
  }
}

pub process name worker_a: Message
pub process name worker_b: Message

fn settle() -> Void needs { clock: Clock } {
  Clock.sleep(Duration.milliseconds(1))
}

fn reply_value(received: Receive<Int>) -> Int {
  case received {
    Receive.Received(value) -> value
    Receive.Drained -> -1
  }
}

fn ask(address: Address<Message>) -> Int {
  let replies = Channel.bounded(1)
  Process.send(address, Message.Report(replies.sender))
  let received = Channel.receive(replies.receiver)
  reply_value(received)
}

pub fn main() -> Int needs { clock: Clock } {
  let a = Process.spec(counter, 1, Duration.seconds(1))
    |> Process.register(worker_a)
    |> Supervisor.process(Supervisor.Restart.Never)
  let root = Supervisor.start(Supervisor.policy([a], 2, Supervisor.restarts(0, Duration.seconds(30))))
  let b = Supervisor.start_process(
    root,
    Process.spec(counter, 1, Duration.seconds(1)) |> Process.register(worker_b),
    Supervisor.Restart.Never,
  )
  Process.send(worker_a, Message.Add(1))
  let refused = case Process.send(worker_a, Message.Add(9)) {
    Success(_) -> 0
    Failure(_) -> 1
  }
  Process.send(Supervisor.address(b), Message.Add(5))
  settle()
  Process.send(worker_a, Message.Add(2))
  settle()
  let total = ask(worker_a)
  Supervisor.stop(root)
  total
}
