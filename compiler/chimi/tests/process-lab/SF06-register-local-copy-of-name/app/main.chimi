import std/duration as Duration
import std/process as Process
import std/process.{Inbox}
import std/supervisor as Supervisor

enum Message {
  Ping
}

fn body(inbox: Inbox<Message>) -> Void {
  Void
}

process name counter: Message

fn build() {
  let local_copy_of_counter = counter
  Process.spec(body, 1, Duration.seconds(1)) |> Process.register(local_copy_of_counter)
}

pub fn main() -> Int {
  0
}
