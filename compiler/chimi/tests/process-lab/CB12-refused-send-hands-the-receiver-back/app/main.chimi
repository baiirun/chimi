import std/channel as Channel
import std/channel.{Receive, Receiver}
import std/clock as Clock
import std/clock.{Clock}
import std/duration as Duration
import std/process as Process
import std/process.{Inbox}
import std/supervisor as Supervisor

// CB12: a Process.send that is refused hands the message's Receiver back to
// the sender (CHI-213). The idle process's mailbox holds one message, so the
// second send fails `Full`; main writes 7 to the returned Receiver's channel
// and reads it back. Had the refusal left the Receiver in flight, or moved it
// to the process, the receive would defect or the channel would abort.

pub enum Message {
  Keep(source: Receiver<Int>)
}

fn idle(inbox: Inbox<Message>) -> Void needs { clock: Clock } {
  Clock.sleep(Duration.seconds(60))
}

pub fn main() -> Int needs { clock: Clock } {
  let root = Supervisor.start(Supervisor.policy([], 1, Supervisor.restarts(0, Duration.seconds(30))))
  let managed = Supervisor.start_process(root, Process.spec(idle, 1, Duration.seconds(1)), Supervisor.Restart.Never)
  let first = Channel.bounded(1)
  let second = Channel.bounded(1)
  let a = case Process.send(Supervisor.address(managed), Message.Keep(first.receiver)) {
    Success(_) -> 0
    Failure(_) -> 10
  }
  let b = case Process.send(Supervisor.address(managed), Message.Keep(second.receiver)) {
    Success(_) -> 100
    Failure(Process.SendError.Full(Message.Keep(back))) -> {
      Channel.send(second.sender, 7)
      let got = Channel.receive(back)
      case got {
        Receive.Received(v) -> v
        Receive.Drained -> -1
      }
    }
    Failure(_) -> 200
  }
  Supervisor.stop(root)
  a + b
}
