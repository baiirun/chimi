import std/clock as Clock
import std/clock.{Clock}
import std/duration as Duration
import std/process as Process
import std/process.{Inbox}
import std/supervisor as Supervisor
import std/supervisor.{StartError}

// SV04: the only declared member, `fragile`, is `Restart.Never` and defects on
// `Crash`, under a supervisor with capacity 1 and restart budget to spare. No
// `restart_attempted` follows the defect, and the slot is free again: a
// dynamic start at capacity succeeds (outcome 1). A runtime that restarted
// without `OnDefect` would show the restart, and its replacement would hold
// the slot, so the start would return `CapacityReached` (outcome -1).

pub enum Message {
  Crash
}

fn wait_for_crash(inbox: Inbox<Message>) -> Void {
  let divisor = case Process.receive(inbox) {
    Message.Crash -> 0
  }
  let quotient = 1 / divisor
  Void
}

pub process name fragile: Message

fn settle() -> Void needs { clock: Clock } {
  Clock.sleep(Duration.milliseconds(1))
}

pub fn main() -> Int needs { clock: Clock } {
  let member = Process.spec(wait_for_crash, 1, Duration.seconds(1))
    |> Process.register(fragile)
    |> Supervisor.process(Supervisor.Restart.Never)
  let root = Supervisor.start(Supervisor.policy([member], 1, Supervisor.restarts(5, Duration.seconds(30))))
  Process.send(fragile, Message.Crash)
  settle()
  let started = case Supervisor.start_process(root, Process.spec(wait_for_crash, 1, Duration.seconds(1)), Supervisor.Restart.Never) {
    Success(_) -> 1
    Failure(error) -> case error {
      StartError.CapacityReached -> -1
      StartError.NameTaken(_) -> -2
      StartError.Stopped -> -3
    }
  }
  Supervisor.stop(root)
  started
}
