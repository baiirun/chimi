import std/channel as Channel
import std/channel.{Receive, Sender}
import std/clock as Clock
import std/clock.{Clock}
import std/duration as Duration
import std/process as Process
import std/process.{Inbox}
import std/supervisor as Supervisor
import std/task as Task

// SD11: the body handles `Compute` by starting a child task that sleeps 1 s
// and returns 7, then waits for its result and reports it. Main removes the
// body while it waits. The drain keeps both running (G22): the child returns
// at 1s, the handler reports 7, and the next `receive` ends the body
// `cancelled`. A shutdown that cancelled children when it began would end the
// body at 1ms with nothing reported. Main then puts 9 on the channel and reads
// the 7 first (outcome 7).

pub enum Message {
  Compute(report: Sender<Int>)
}

fn slow_answer() -> Int needs { clock: Clock } {
  Clock.sleep(Duration.seconds(1))
  7
}

fn computing(inbox: Inbox<Message>) -> Void needs { clock: Clock } {
  loop answered = 0 {
    case Process.receive(inbox) {
      Message.Compute(report) -> {
        let child = Task.start(slow_answer)
        Channel.send(report, Task.result(child))
        answered + 1
      }
    }
  }
}

fn settle() -> Void needs { clock: Clock } {
  Clock.sleep(Duration.milliseconds(1))
}

fn received(value: Receive<Int>) -> Int {
  case value {
    Receive.Received(number) -> number
    Receive.Drained -> 0
  }
}

pub fn main() -> Int needs { clock: Clock } {
  let root = Supervisor.start(Supervisor.policy([], 1, Supervisor.restarts(0, Duration.seconds(30))))
  let managed = Supervisor.start_process(root, Process.spec(computing, 1, Duration.seconds(5)), Supervisor.Restart.Never)
  let reports = Channel.bounded(2)
  Process.send(Supervisor.address(managed), Message.Compute(reports.sender))
  settle()
  Supervisor.remove_process(root, managed)
  Channel.send(reports.sender, 9)
  let first = received(Channel.receive(reports.receiver))
  Supervisor.stop(root)
  first
}
