import std/channel as Channel.{Receive, Sender}
import std/clock as Clock.{Clock}
import std/duration as Duration
import std/process as Process.{Inbox, SendError}
import std/supervisor as Supervisor

// SD06: the declared member `counter` is the oldest, so `stop` ends it last.
// Main queues `Forward(1, report)` on the newest member and calls `stop`
// before it runs. Shutdown is ordered (G22): `stop` closes the supervisor to
// new members, then stops one member at a time, newest first, and each
// member is unrouted only when its own turn comes. The newest member drains
// the request and sends `Add(1)` to `counter`, which stops after it and is
// still routable, so the send is accepted and the newest reports 1; `counter`
// then drains it. Routing removed for the whole subtree first would make the
// send `Unavailable` and report 3.

pub enum CounterMessage {
  Add(amount: Int)
}

pub enum ForwarderMessage {
  Forward(amount: Int, report: Sender<Int>)
}

pub process name counter: CounterMessage

fn counting(inbox: Inbox<CounterMessage>) -> Void {
  loop total = 0 {
    case Process.receive(inbox) {
      CounterMessage.Add(amount) -> total + amount
    }
  }
}

fn forwarding(inbox: Inbox<ForwarderMessage>) -> Void {
  loop forwarded = 0 {
    case Process.receive(inbox) {
      ForwarderMessage.Forward(amount, report) -> {
        let code = case Process.send(counter, CounterMessage.Add(amount)) {
          Success(_) -> 1
          Failure(error) -> case error {
            SendError.Full(_) -> 2
            SendError.Unavailable(_) -> 3
          }
        }
        Channel.send(report, code)
        forwarded + 1
      }
    }
  }
}

fn settle() -> Void needs {
  clock: Clock
} {
  Clock.sleep(Duration.milliseconds(1))
}

fn received(value: Receive<Int>) -> Int {
  case value {
    Receive.Received(number) -> number
    Receive.Drained -> 0
  }
}

pub fn main() -> Int needs {
  clock: Clock
} {
  let member = Process.spec(counting, 1, Duration.seconds(1))
  |> Process.register(counter)
  |> Supervisor.process(Supervisor.Restart.Never)
  let root = Supervisor.start(Supervisor.policy([member], 2, Supervisor.restarts(0, Duration.seconds(30))))
  let newest = Supervisor.start_process(root, Process.spec(forwarding, 1, Duration.seconds(1)), Supervisor.Restart.Never)
  let reports = Channel.bounded(1)
  settle()
  Process.send(Supervisor.address(newest), ForwarderMessage.Forward(1, reports.sender))
  Supervisor.stop(root)
  received(Channel.receive(reports.receiver))
}
