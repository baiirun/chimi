import std/channel as Channel.{Receiver}
import std/duration as Duration
import std/process as Process.{Inbox}
import std/supervisor as Supervisor.{Running}

enum Message {
  Stop
}

fn serve(inbox: Inbox<Message>, requests: Receiver<Int>) -> Void {
  Void
}

fn accept(root: Running, requests: Receiver<Int>) {
  Supervisor.start_handoff(root, Process.handoff_spec(serve, 4, Duration.seconds(1)), requests)
  Channel.abort(requests)
}

pub fn main() -> Int {
  0
}
