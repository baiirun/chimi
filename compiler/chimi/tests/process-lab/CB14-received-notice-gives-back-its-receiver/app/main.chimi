import std/channel as Channel
import std/channel.{Receive, Receiver, Sender}
import std/debug as Debug
import std/duration as Duration
import std/process as Process
import std/process.{Address, Down, Inbox}
import std/supervisor as Supervisor

// CHI-227: a notice that fires and is received gives the watcher back the
// Receiver it captured. The watcher monitors `worker` with a notice holding
// `data`'s Receiver; main sends 5 on `data` and lets the worker return. The
// watcher receives the notice and reads `data` through the Receiver: 5. A
// runtime that left the Receiver in flight would defect the watcher's
// receive, and main's reply would drain (-1).

pub enum Job {
  Return
}

pub enum Watch {
  Begin(worker: Address<Job>, source: Receiver<Int>, reply: Sender<Int>)
  Gone(down: Down, source: Receiver<Int>)
}

pub process name worker: Job
pub process name watcher: Watch

fn work(inbox: Inbox<Job>) -> Void {
  case Process.receive(inbox) {
    Job.Return -> Void
  }
}

fn watch(inbox: Inbox<Watch>) -> Void {
  case Process.receive(inbox) {
    Watch.Begin(target, source, reply) -> {
      let _ = Process.monitor(inbox, target, fn(down) { Watch.Gone(down, source) })
      case Process.receive(inbox) {
        Watch.Gone(_, back) -> {
          let next = Channel.receive(back)
          case next {
            Receive.Received(value) -> Channel.send(reply, value)
            Receive.Drained -> Channel.send(reply, 0)
          }
        }
        Watch.Begin(_, _, _) -> Debug.crash("unexpected begin")
      }
    }
    Watch.Gone(_, _) -> Debug.crash("unexpected notice")
  }
}

pub fn main() -> Int {
  let working = Process.spec(work, 1, Duration.seconds(1))
    |> Process.register(worker)
    |> Supervisor.process(Supervisor.Restart.Never)
  let watching = Process.spec(watch, 1, Duration.seconds(1))
    |> Process.register(watcher)
    |> Supervisor.process(Supervisor.Restart.Never)
  let root = Supervisor.start(Supervisor.policy([working, watching], 2, Supervisor.restarts(0, Duration.seconds(30))))
  let data = Channel.bounded(1)
  let replies = Channel.bounded(1)
  Process.send(watcher, Watch.Begin(worker, data.receiver, replies.sender))
  Channel.send(data.sender, 5)
  Process.send(worker, Job.Return)
  let received = Channel.receive(replies.receiver)
  let value = case received {
    Receive.Received(value) -> value
    Receive.Drained -> -1
  }
  Supervisor.stop(root)
  value
}
