import std/channel as Channel
import std/channel.{Receive, Sender}
import std/clock as Clock
import std/clock.{Clock}
import std/duration as Duration
import std/process as Process
import std/process.{Address, Inbox, SendError}
import std/supervisor as Supervisor

// MB01: main and a relay process both send to `sink`, which records the order
// in which it receives values as decimal digits. The relay is declared first, so
// it runs first; by then main has queued 2 and 3, and the relay's 1 is accepted
// after them. Delivery in acceptance order reads 231. Serving senders in turn
// (main, relay, main) would read 213.
pub enum Message {
  Note(value: Int)
  Report(reply: Sender<Int>)
}

pub enum RelayMessage {
  Forward(value: Int)
}

pub process name sink: Message
pub process name relay: RelayMessage

fn record(inbox: Inbox<Message>) -> Void {
  loop order = 0 {
    case Process.receive(inbox) {
      Message.Note(value) -> order * 10 + value
      Message.Report(reply) -> {
        Channel.send(reply, order)
        order
      }
    }
  }
}

fn forward(inbox: Inbox<RelayMessage>) -> Void {
  loop forwarded = 0 {
    case Process.receive(inbox) {
      RelayMessage.Forward(value) -> {
        Process.send(sink, Message.Note(value))
        forwarded + 1
      }
    }
  }
}

fn settle() -> Void needs { clock: Clock } {
  Clock.sleep(Duration.milliseconds(1))
}

fn reply_value(received: Receive<Int>) -> Int {
  case received {
    Receive.Received(value) -> value
    Receive.Drained -> -1
  }
}

fn ask(address: Address<Message>) -> Int {
  let replies = Channel.bounded(1)
  Process.send(address, Message.Report(replies.sender))
  let received = Channel.receive(replies.receiver)
  reply_value(received)
}

pub fn main() -> Int needs { clock: Clock } {
  let relaying = Process.spec(forward, 4, Duration.seconds(1))
    |> Process.register(relay)
    |> Supervisor.process(Supervisor.Restart.Never)
  let recording = Process.spec(record, 4, Duration.seconds(1))
    |> Process.register(sink)
    |> Supervisor.process(Supervisor.Restart.Never)
  let root = Supervisor.start(Supervisor.policy([relaying, recording], 2, Supervisor.restarts(0, Duration.seconds(30))))
  Process.send(sink, Message.Note(2))
  Process.send(relay, RelayMessage.Forward(1))
  Process.send(sink, Message.Note(3))
  settle()
  let order = ask(sink)
  Supervisor.stop(root)
  order
}
