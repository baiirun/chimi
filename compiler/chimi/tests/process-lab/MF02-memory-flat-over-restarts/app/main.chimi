import std/channel as Channel
import std/channel.{Receive, Sender}
import std/clock as Clock
import std/clock.{Clock}
import std/duration as Duration
import std/int as Int
import std/process as Process
import std/process.{Inbox}
import std/supervisor as Supervisor
import std/list as List

// MF02: `worker` defects N times under `restarts(1, 1s)`, one defect per
// virtual second, so each restart rolls the previous one out of the window
// and every defect restarts. After the last cycle the replacement counts
// Add(5) from 0 and reports 5, so the outcome is 5 for N = 100 and
// N = 10,000. The live allocations and live fragments at exit do not grow
// with N (expected.memory): a restart that kept its incarnation's heap, its
// spec copy, or a fragment of the crash message would.

pub enum Message {
  Add(amount: Int)
  Crash
  Report(reply: Sender<Int>)
}

fn counter(inbox: Inbox<Message>) -> Void {
  loop total = 0 {
    case Process.receive(inbox) {
      Message.Add(amount) -> total + amount
      Message.Crash -> total / 0
      Message.Report(reply) -> {
        Channel.send(reply, total)
        total
      }
    }
  }
}

pub process name worker: Message

fn ask() -> Int {
  let replies = Channel.bounded(1)
  Process.send(worker, Message.Report(replies.sender))
  let reply = Channel.receive(replies.receiver)
  case reply {
    Receive.Received(value) -> value
    Receive.Drained -> -1
  }
}

pub fn main(arguments: List<Text>) -> Int needs { clock: Clock } {
  let cycles = case List.first(arguments) {
    Some(text) -> Int.parse(text)
    None -> 0
  }
  let member = Process.spec(counter, 4, Duration.seconds(1))
    |> Process.register(worker)
    |> Supervisor.process(Supervisor.Restart.OnDefect)
  let root = Supervisor.start(Supervisor.policy([member], 1, Supervisor.restarts(1, Duration.seconds(1))))
  let done = loop left = cycles {
    case left {
      0 -> break cycles
      _ -> {
        Process.send(worker, Message.Add(1))
        Process.send(worker, Message.Crash)
        Clock.sleep(Duration.seconds(1))
        left - 1
      }
    }
  }
  Process.send(worker, Message.Add(5))
  let total = ask()
  Supervisor.stop(root)
  total
}
