import std/channel as Channel
import std/channel.{Receive, Sender}
import std/clock as Clock
import std/clock.{Clock}
import std/duration as Duration
import std/process as Process
import std/process.{Address, Down, Inbox}
import std/supervisor as Supervisor

// MB19: `watcher` monitors `worker`, which lives under another root. Main
// asks the watcher to nap (a 1 s handler) and stops the watcher's root while
// it naps, so the watcher drains. During the drain the worker ends (it
// returns at 500ms), which would queue a `Down` notice. A watcher under
// shutdown accepts no notice, so it is dropped: the watcher reports only its
// nap, 1, at 1.001s, and its next `receive` ends it. Main then puts 9 on the
// channel and reads 1 and 9 (outcome 19). A notice delivered during the drain
// would have been reported as 2 first, after the 1 (outcome 12).

pub enum Job {
  NapThenReturn
}

pub enum Watch {
  Begin(target: Address<Job>, report: Sender<Int>)
  Nap
  Gone(down: Down)
}

pub process name worker: Job
pub process name watcher: Watch

fn work(inbox: Inbox<Job>) -> Void needs { clock: Clock } {
  case Process.receive(inbox) {
    Job.NapThenReturn -> Clock.sleep(Duration.milliseconds(500))
  }
}

fn watch(inbox: Inbox<Watch>) -> Void needs { clock: Clock } {
  case Process.receive(inbox) {
    Watch.Begin(target, report) -> {
      Process.monitor(inbox, target, fn(down) { Watch.Gone(down) })
      loop naps = 0 {
        case Process.receive(inbox) {
          Watch.Nap -> {
            Clock.sleep(Duration.seconds(1))
            Channel.send(report, 1)
            naps + 1
          }
          Watch.Gone(_) -> {
            Channel.send(report, 2)
            naps
          }
          Watch.Begin(_, _) -> naps
        }
      }
    }
    Watch.Nap -> Void
    Watch.Gone(_) -> Void
  }
}

fn settle() -> Void needs { clock: Clock } {
  Clock.sleep(Duration.milliseconds(1))
}

fn received(value: Receive<Int>) -> Int {
  case value {
    Receive.Received(number) -> number
    Receive.Drained -> 0
  }
}

pub fn main() -> Int needs { clock: Clock } {
  let restarts = Supervisor.restarts(0, Duration.seconds(30))
  let working = Process.spec(work, 1, Duration.seconds(5))
    |> Process.register(worker)
    |> Supervisor.process(Supervisor.Restart.Never)
  let watching = Process.spec(watch, 2, Duration.seconds(5))
    |> Process.register(watcher)
    |> Supervisor.process(Supervisor.Restart.Never)
  let workers = Supervisor.start(Supervisor.policy([working], 1, restarts))
  let watchers = Supervisor.start(Supervisor.policy([watching], 1, restarts))
  let reports = Channel.bounded(3)
  Process.send(watcher, Watch.Begin(worker, reports.sender))
  settle()
  Process.send(worker, Job.NapThenReturn)
  Process.send(watcher, Watch.Nap)
  settle()
  Supervisor.stop(watchers)
  Channel.send(reports.sender, 9)
  let first = received(Channel.receive(reports.receiver))
  let second = received(Channel.receive(reports.receiver))
  Supervisor.stop(workers)
  first * 10 + second
}
