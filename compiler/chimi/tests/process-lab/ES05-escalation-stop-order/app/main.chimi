import std/clock as Clock
import std/clock.{Clock}
import std/duration as Duration
import std/process as Process
import std/process.{Inbox}
import std/supervisor as Supervisor

// ES05: two declared members (`first`, `second`) and two dynamic ones, all
// parked, under `restarts(0, 30s)`. `first` defects, so the root escalates. It
// stops the dynamic members newest first, then the remaining declared member,
// and only then reports `supervisor_escalated`. The program ends with
// `Supervisor.RestartLimitExceeded` while main waits on the root.

pub enum Message {
  Crash
}

fn wait_for_crash(inbox: Inbox<Message>) -> Void {
  let divisor = case Process.receive(inbox) {
    Message.Crash -> 0
  }
  let quotient = 1 / divisor
  Void
}

pub process name first: Message
pub process name second: Message

fn settle() -> Void needs { clock: Clock } {
  Clock.sleep(Duration.milliseconds(1))
}

pub fn main() -> Int needs { clock: Clock } {
  let declared_first = Process.spec(wait_for_crash, 1, Duration.seconds(1))
    |> Process.register(first)
    |> Supervisor.process(Supervisor.Restart.OnDefect)
  let declared_second = Process.spec(wait_for_crash, 1, Duration.seconds(1))
    |> Process.register(second)
    |> Supervisor.process(Supervisor.Restart.OnDefect)
  let root = Supervisor.start(Supervisor.policy([declared_first, declared_second], 4, Supervisor.restarts(0, Duration.seconds(30))))
  let older = Supervisor.start_process(root, Process.spec(wait_for_crash, 1, Duration.seconds(1)), Supervisor.Restart.OnDefect)
  let newer = Supervisor.start_process(root, Process.spec(wait_for_crash, 1, Duration.seconds(1)), Supervisor.Restart.OnDefect)
  settle()
  Process.send(first, Message.Crash)
  Supervisor.wait(root)
  0
}
