import std/clock as Clock
import std/clock.{Clock}
import std/duration as Duration
import std/process as Process
import std/process.{Inbox}
import std/supervisor as Supervisor

// ES01: `counter` and `peer` are declared `OnDefect` under `restarts(1, 30s)`.
// Main sends `Crash` to `counter`, settles, sends `Crash` again, and parks in
// `Supervisor.wait(root)`. The second defect exceeds the limit: the refused
// attempt is not recorded, `peer` is stopped, the root escalates, and the
// program ends with `Supervisor.RestartLimitExceeded`. The wait never returns.

pub enum Message {
  Crash
}

fn wait_for_crash(inbox: Inbox<Message>) -> Void {
  let divisor = case Process.receive(inbox) {
    Message.Crash -> 0
  }
  let quotient = 1 / divisor
  Void
}

pub process name counter: Message
pub process name peer: Message

fn settle() -> Void needs { clock: Clock } {
  Clock.sleep(Duration.milliseconds(1))
}

pub fn main() -> Int needs { clock: Clock } {
  let first = Process.spec(wait_for_crash, 1, Duration.seconds(1))
    |> Process.register(counter)
    |> Supervisor.process(Supervisor.Restart.OnDefect)
  let second = Process.spec(wait_for_crash, 1, Duration.seconds(1))
    |> Process.register(peer)
    |> Supervisor.process(Supervisor.Restart.OnDefect)
  let root = Supervisor.start(Supervisor.policy([first, second], 2, Supervisor.restarts(1, Duration.seconds(30))))
  Process.send(counter, Message.Crash)
  settle()
  Process.send(counter, Message.Crash)
  Supervisor.wait(root)
  0
}
