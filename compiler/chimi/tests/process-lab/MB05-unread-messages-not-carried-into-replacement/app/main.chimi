import std/channel as Channel
import std/channel.{Receive, Sender}
import std/clock as Clock
import std/clock.{Clock}
import std/duration as Duration
import std/process as Process
import std/process.{Address, Inbox}
import std/supervisor as Supervisor

// MB05: `Crash` and then `Add(5)` are both accepted before `counter` first
// runs. The body defects on `Crash`, so `Add(5)` is still unread when the
// incarnation ends. The replacement starts with an empty mailbox and reports 0;
// a runtime that carried the unread message over would report 5. The discarded
// message's fragment is freed (expected.memory).

pub enum Message {
  Add(amount: Int)
  Crash
  Report(reply: Sender<Int>)
}

fn count_messages(inbox: Inbox<Message>) -> Void {
  loop total = 0 {
    case Process.receive(inbox) {
      Message.Add(amount) -> total + amount
      Message.Crash -> total / 0
      Message.Report(reply) -> {
        Channel.send(reply, total)
        total
      }
    }
  }
}

pub process name counter: Message

fn settle() -> Void needs { clock: Clock } {
  Clock.sleep(Duration.milliseconds(1))
}

fn reply_value(received: Receive<Int>) -> Int {
  case received {
    Receive.Received(value) -> value
    Receive.Drained -> -1
  }
}

fn ask(address: Address<Message>) -> Int {
  let replies = Channel.bounded(1)
  Process.send(address, Message.Report(replies.sender))
  reply_value(Channel.receive(replies.receiver))
}

pub fn main() -> Int needs { clock: Clock } {
  let member = Process.spec(count_messages, 4, Duration.seconds(1))
    |> Process.register(counter)
    |> Supervisor.process(Supervisor.Restart.OnDefect)
  let root = Supervisor.start(Supervisor.policy([member], 1, Supervisor.restarts(1, Duration.seconds(30))))
  Process.send(counter, Message.Crash)
  Process.send(counter, Message.Add(5))
  settle()
  let total = ask(counter)
  Supervisor.stop(root)
  total
}
