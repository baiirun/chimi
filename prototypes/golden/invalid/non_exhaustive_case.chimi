// EXPECT-MESSAGE: case does not handle CheckoutState.Submitted
// EXPECT-SPAN: case state

enum CheckoutState {
  Empty
  Ready
  Submitted(order_id: Text)
}

fn is_open(state: CheckoutState) -> Bool {
  case state {
    Empty -> True
    Ready -> True
  }
}
