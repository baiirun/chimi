// PROTOTYPE
// EXPECT-COMPILE: success
// EXPECT-SHAPE: submit =
//   fn(Cart) -> Order errors CheckoutError
//   needs { payment: Payment, inventory: Inventory }
// EXPECT-RUN: Success(Order(id: OrderId(value: "order-1")))
// EXPECT-ROOT-REQUIREMENTS: {}
// EXPECT-EVENTS: computation.started, dependency.called, dependency.called,
//   computation.completed

struct Cart {
  items: List<Item>
  total: Money
}

struct Item {
  sku: Text
}

struct Money {
  cents: Int
}

struct OrderId {
  value: Text
}

struct Order {
  id: OrderId
}

enum PaymentError {
  Declined(reason: Text)
}

enum InventoryError {
  Unavailable(item: Item)
}

enum CheckoutError {
  PaymentFailed(error: PaymentError)
  InventoryFailed(error: InventoryError)
}

interface Payment {
  charge: fn(Money) -> Receipt errors PaymentError
}

interface Inventory {
  reserve: fn(List<Item>) -> Reservation errors InventoryError
}

struct Receipt {
  id: Text
}

struct Reservation {
  id: Text
}

fn submit(cart: Cart)
  needs {
    payment: Payment,
    inventory: Inventory,
  }
{
  case inventory.reserve(cart.items) {
    Failure(error) -> Failure(InventoryFailed(error))
    Success(_reservation) -> case payment.charge(cart.total) {
      Failure(error) -> Failure(PaymentFailed(error))
      Success(_receipt) -> Order(id: OrderId(value: "order-1"))
    }
  }
}

let fake_inventory = {
  reserve: fn(_items) { Reservation(id: "reservation-1") },
}

let fake_payment = {
  charge: fn(_total) { Receipt(id: "receipt-1") },
}

pub fn main() {
  submit(Cart(items: [], total: Money(cents: 0))) using {
    payment: fake_payment,
    inventory: fake_inventory,
  }
}
