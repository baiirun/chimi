// PROTOTYPE: this module must remain implementable without retry-specific machinery.

pub enum Policy {
  Once
}

pub fn once() -> Policy {
  Once()
}

pub fn with<A, E, R>(
  operation: fn() -> A errors E needs R,
  policy: Policy,
) -> fn() -> A errors E needs R {
  case policy {
    Once -> fn() {
      case operation() {
        Success(value) -> value
        Failure(_error) -> operation()
      }
    }
  }
}
