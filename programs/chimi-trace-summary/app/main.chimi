import std/io as IO
import std/io.{Close}
import std/io.{Console}
import std/io.{FileSystem}
import std/io.{InvalidUtf8}
import std/io.{LineTooLong}
import std/io.{Open}
import std/io.{Read}
import std/json as Json
import std/json.{Number}
import std/json.{Value}
import std/map as Map
import std/map.{Map}

struct Summary {
  line: Int,
  records: Int,
  events: Int,
  previous_sequence: Option<Int>,
  execution_id: Option<Text>,
  computation: Option<Text>,
  terminal_seen: Bool,
  operations: Map<Text, Int>,
  dependency_calls: Map<Text, Int>,
  terminal_outcomes: Map<Text, Int>,
}

enum TraceError {
  InvalidArgumentCount(actual: Int)
  BlankLine(line: Int)
  InvalidJson(line: Int)
  InvalidSchema(line: Int)
  InvalidRecord(line: Int)
  InvalidEvent(line: Int)
  InvalidSequence(line: Int)
  MixedExecution(line: Int)
  MixedComputation(line: Int)
  RecordAfterOutcome(line: Int)
  MissingOutcome(line: Int)
}

fn increment(counts: Map<Text, Int>, key: Text) {
  Map.update(counts, key, fn(current) {
    case current {
      Some(count) -> count + 1
      None -> 1
    }
  })
}

fn empty() -> Summary {
  Summary(
    1,
    0,
    0,
    None(),
    None(),
    None(),
    False,
    Map.empty(),
    Map.empty(),
    Map.empty(),
  )
}

fn same_execution(current: Option<Text>, candidate: Text, line: Int) {
  case current {
    Some(value) -> case Text.equal(value, candidate) {
      True -> current
      False -> Failure(MixedExecution(line))
    }
    None -> Some(candidate)
  }
}

fn same_computation(current: Option<Text>, candidate: Text, line: Int) {
  case current {
    Some(value) -> case Text.equal(value, candidate) {
      True -> current
      False -> Failure(MixedComputation(line))
    }
    None -> Some(candidate)
  }
}

fn increasing_sequence(previous: Option<Int>, raw: Number, line: Int) {
  case Json.number_to_int(raw) {
    Success(sequence) -> case previous {
      Some(value) -> case sequence > value {
        True -> Some(sequence)
        False -> Failure(InvalidSequence(line))
      }
      None -> Some(sequence)
    }
    Failure(_) -> Failure(InvalidSequence(line))
  }
}

fn validate_schema(fields: Map<Text, Value>, line: Int) {
  case Map.get(fields, "schema") {
    Some(Value.Text(schema)) -> case Text.equal(schema, "chimi.runtime.v1") {
      True -> fields
      False -> Failure(InvalidSchema(line))
    }
    _ -> Failure(InvalidSchema(line))
  }
}

fn validate_event_context(state: Summary, fields: Map<Text, Value>) {
  case Map.get(fields, "sequence"), Map.get(fields, "execution_id"), Map.get(fields, "computation") {
    Some(Value.Number(sequence)), Some(Value.Text(execution_id)), Some(Value.Text(computation)) -> {
      let next_sequence = increasing_sequence(state.previous_sequence, sequence, state.line)
      let next_execution = same_execution(state.execution_id, execution_id, state.line)
      let next_computation = same_computation(state.computation, computation, state.line)
      Summary(
        state.line,
        state.records,
        state.events,
        next_sequence,
        next_execution,
        next_computation,
        state.terminal_seen,
        state.operations,
        state.dependency_calls,
        state.terminal_outcomes,
      )
    }
    _, _, _ -> Failure(InvalidRecord(state.line))
  }
}

fn add_dependency(state: Summary, attributes: Map<Text, Value>) {
  case Map.get(attributes, "requirement"), Map.get(attributes, "method") {
    Some(Value.Text(requirement)), Some(Value.Text(method)) -> {
      let prefix = Text.append(requirement, ".")
      Summary(
        state.line + 1,
        state.records + 1,
        state.events + 1,
        state.previous_sequence,
        state.execution_id,
        state.computation,
        state.terminal_seen,
        state.operations,
        increment(state.dependency_calls, Text.append(prefix, method)),
        state.terminal_outcomes,
      )
    }
    _, _ -> Failure(InvalidRecord(state.line))
  }
}

fn add_event(state: Summary, fields: Map<Text, Value>, event: Text) {
  let context = validate_event_context(state, fields)
  case event {
    "dependency_called" -> case Map.get(fields, "attributes") {
      Some(Value.Object(attributes)) -> add_dependency(context, attributes)
      _ -> Failure(InvalidRecord(state.line))
    }
    "operation_completed" -> case Map.get(fields, "operation") {
      Some(Value.Text(operation)) -> Summary(
        state.line + 1,
        state.records + 1,
        state.events + 1,
        context.previous_sequence,
        context.execution_id,
        context.computation,
        state.terminal_seen,
        increment(state.operations, operation),
        state.dependency_calls,
        state.terminal_outcomes,
      )
      _ -> Failure(InvalidRecord(state.line))
    }
    "computation_started" -> add_plain_event(context)
    "computation_completed" -> add_plain_event(context)
    "operation_started" -> add_plain_event(context)
    _ -> Failure(InvalidEvent(state.line))
  }
}

fn add_plain_event(state: Summary) {
  Summary(
    state.line + 1,
    state.records + 1,
    state.events + 1,
    state.previous_sequence,
    state.execution_id,
    state.computation,
    state.terminal_seen,
    state.operations,
    state.dependency_calls,
    state.terminal_outcomes,
  )
}

fn add_outcome(state: Summary, outcome: Text) {
  let terminal_outcomes = case outcome {
    "success" -> increment(state.terminal_outcomes, outcome)
    "expected_failure" -> increment(state.terminal_outcomes, outcome)
    "defect" -> increment(state.terminal_outcomes, outcome)
    "cancellation" -> increment(state.terminal_outcomes, outcome)
    _ -> Failure(InvalidRecord(state.line))
  }
  Summary(
    state.line + 1,
    state.records + 1,
    state.events,
    state.previous_sequence,
    state.execution_id,
    state.computation,
    True,
    state.operations,
    state.dependency_calls,
    terminal_outcomes,
  )
}

fn decode_line(state: Summary, line: Text) {
  case line {
    "" -> Failure(BlankLine(state.line))
    _ -> case Json.decode(line) {
      Success(Value.Object(fields)) -> {
        let checked = validate_schema(fields, state.line)
        case Map.get(checked, "event"), Map.get(checked, "outcome") {
          Some(Value.Text(event)), None -> add_event(state, checked, event)
          None, Some(Value.Text(outcome)) -> add_outcome(state, outcome)
          _, _ -> Failure(InvalidRecord(state.line))
        }
      }
      Success(_) -> Failure(InvalidRecord(state.line))
      Failure(_) -> Failure(InvalidJson(state.line))
    }
  }
}

fn add_line(state: Summary, line: Text) {
  case state.terminal_seen {
    True -> Failure(RecordAfterOutcome(state.line))
    False -> decode_line(state, line)
  }
}

fn render(state: Summary) -> Text {
  let fields0 = Map.put(Map.empty(), "schema", Json.text("chimi.trace-summary.v1"))
  let fields1 = Map.put(fields0, "records", Json.int(state.records))
  let fields2 = Map.put(fields1, "events", Json.int(state.events))
  let fields3 = Map.put(fields2, "operations", Json.object(Map.map_values(state.operations, Json.int)))
  let fields4 = Map.put(fields3, "dependency_calls", Json.object(Map.map_values(state.dependency_calls, Json.int)))
  let fields5 = Map.put(fields4, "terminal_outcomes", Json.object(Map.map_values(state.terminal_outcomes, Json.int)))
  Json.encode(Json.object(fields5))
}

fn finish(state: Summary) {
  case state.terminal_seen {
    True -> render(state)
    False -> Failure(MissingOutcome(state.line))
  }
}

fn report_trace(error: TraceError) -> Void
  needs { console: Console }
{
  console.write_error("trace summary failed")
  Failure(error)
}

pub fn main(arguments: List<Text>) -> Void
  needs {
    files: FileSystem,
    console: Console,
  }
{
  case List.length(arguments), List.first(arguments) {
    1, Some(path) -> case files.process_utf8_lines(IO.path(path), empty(), add_line) {
      Success(state) -> case finish(state) {
        Success(report) -> console.write_line(report)
        Failure(MissingOutcome(line)) -> report_trace(MissingOutcome(line))
      }
      Failure(BlankLine(line)) -> report_trace(BlankLine(line))
      Failure(InvalidJson(line)) -> report_trace(InvalidJson(line))
      Failure(InvalidSchema(line)) -> report_trace(InvalidSchema(line))
      Failure(InvalidRecord(line)) -> report_trace(InvalidRecord(line))
      Failure(InvalidEvent(line)) -> report_trace(InvalidEvent(line))
      Failure(InvalidSequence(line)) -> report_trace(InvalidSequence(line))
      Failure(MixedExecution(line)) -> report_trace(MixedExecution(line))
      Failure(MixedComputation(line)) -> report_trace(MixedComputation(line))
      Failure(RecordAfterOutcome(line)) -> report_trace(RecordAfterOutcome(line))
      Failure(Open(path, message)) -> {
        console.write_error("trace summary file IO failed")
        Failure(Open(path, message))
      }
      Failure(Read(path, message)) -> {
        console.write_error("trace summary file IO failed")
        Failure(Read(path, message))
      }
      Failure(Close(path, message)) -> {
        console.write_error("trace summary file IO failed")
        Failure(Close(path, message))
      }
      Failure(LineTooLong(path, limit)) -> {
        console.write_error("trace summary input record is too large")
        Failure(LineTooLong(path, limit))
      }
      Failure(InvalidUtf8(path, line)) -> {
        console.write_error("trace summary input is not UTF-8")
        Failure(InvalidUtf8(path, line))
      }
    }
    count, _ -> {
      console.write_error("usage: chimi-trace-summary <path-or-dash>")
      Failure(InvalidArgumentCount(count))
    }
  }
}
