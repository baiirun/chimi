import std/io as IO.{Console, FileError, FileSystem, LineTooLong, Utf8Error}
import std/json as Json.{Number, Value}
import std/map as Map.{Map}
import std/list as List

const runtime_schema = "chimi.runtime.v1"
const summary_schema = "chimi.trace-summary.v1"
const usage = "usage: chimi-trace-summary <path-or-dash>"

struct Summary {
  line: Int,
  records: Int,
  events: Int,
  previous_sequence: Option<Int>,
  execution_id: Option<Text>,
  computation: Option<Text>,
  terminal_seen: Bool,
  operations: Map<Text, Int>,
  dependency_calls: Map<Text, Int>,
  terminal_outcomes: Map<Text, Int>,
}

const empty_summary = Summary(
  1,
  0,
  0,
  None,
  None,
  None,
  False,
  Map.empty(),
  Map.empty(),
  Map.empty(),
)

enum TraceError {
  InvalidArgumentCount(actual: Int)
  BlankLine(line: Int)
  InvalidJson(line: Int)
  InvalidSchema(line: Int)
  InvalidRecord(line: Int)
  InvalidEvent(line: Int)
  InvalidSequence(line: Int)
  MixedExecution(line: Int)
  MixedComputation(line: Int)
  RecordAfterOutcome(line: Int)
  MissingOutcome(line: Int)
}

fn increment(counts: Map<Text, Int>, key: Text) {
  Map.update(counts, key, fn(current) {
    case current {
      Some(count) -> count + 1
      None -> 1
    }
  })
}

// Every record of one trace names the same execution and computation.
fn same_identity(current: Option<Text>, candidate: Text, mismatch: TraceError) -> Option<Text> {
  case current {
    Some(value) if value == candidate -> current
    Some(_) -> Failure(mismatch)
    None -> Some(candidate)
  }
}

fn next_sequence(previous: Option<Int>, raw: Number, line: Int) -> Option<Int> {
  let sequence = case Json.number_to_int(raw) {
    Success(sequence) -> sequence
    Failure(_) -> Failure(InvalidSequence(line))
  }
  case previous {
    Some(last) if sequence <= last -> Failure(InvalidSequence(line))
    _ -> Some(sequence)
  }
}

fn check_schema(fields: Map<Text, Value>, line: Int) -> Map<Text, Value> {
  case Map.get(fields, "schema") {
    Some(Value.Text(schema)) if schema == runtime_schema -> fields
    _ -> Failure(InvalidSchema(line))
  }
}

// Counts an event record after checking the context that every event carries.
fn count_event(state: Summary, fields: Map<Text, Value>) -> Summary {
  case Map.get(fields, "sequence"), Map.get(fields, "execution_id"), Map.get(fields, "computation") {
    Some(Value.Number(sequence)), Some(Value.Text(execution_id)), Some(Value.Text(computation)) -> {
      ..state,
      events: state.events + 1,
      previous_sequence: next_sequence(state.previous_sequence, sequence, state.line),
      execution_id: same_identity(state.execution_id, execution_id, MixedExecution(state.line)),
      computation: same_identity(state.computation, computation, MixedComputation(state.line)),
    }
    _, _, _ -> Failure(InvalidRecord(state.line))
  }
}

fn dependency_name(attributes: Map<Text, Value>, line: Int) -> Text {
  case Map.get(attributes, "requirement"), Map.get(attributes, "method") {
    Some(Value.Text(requirement)), Some(Value.Text(method)) -> "${requirement}.${method}"
    _, _ -> Failure(InvalidRecord(line))
  }
}

fn add_event(state: Summary, event: Text, fields: Map<Text, Value>) -> Summary {
  case event {
    "dependency_called" -> case Map.get(fields, "attributes") {
      Some(Value.Object(attributes)) -> {
        ..state,
        dependency_calls: increment(state.dependency_calls, dependency_name(attributes, state.line)),
      }
      _ -> Failure(InvalidRecord(state.line))
    }
    "operation_completed" -> case Map.get(fields, "operation") {
      Some(Value.Text(operation)) -> {
        ..state, operations: increment(state.operations, operation)
      }
      _ -> Failure(InvalidRecord(state.line))
    }
    "computation_started" -> state
    "computation_completed" -> state
    "operation_started" -> state
    _ -> Failure(InvalidEvent(state.line))
  }
}

fn is_terminal_outcome("success") -> Bool {
  True
}
fn is_terminal_outcome("expected_failure") {
  True
}
fn is_terminal_outcome("defect") {
  True
}
fn is_terminal_outcome("cancellation") {
  True
}
fn is_terminal_outcome(_) {
  False
}

fn add_outcome(state: Summary, outcome: Text) -> Summary {
  case is_terminal_outcome(outcome) {
    True -> {
      ..state,
      terminal_seen: True,
      terminal_outcomes: increment(state.terminal_outcomes, outcome),
    }
    False -> Failure(InvalidRecord(state.line))
  }
}

fn add_fields(state: Summary, fields: Map<Text, Value>) -> Summary {
  case Map.get(fields, "event"), Map.get(fields, "outcome") {
    // The context is checked before the event name, so a record with both
    // problems reports its context.
    Some(Value.Text(event)), None -> {
      state
      |> count_event(fields)
      |> add_event(event, fields)
    }
    None, Some(Value.Text(outcome)) -> add_outcome(state, outcome)
    _, _ -> Failure(InvalidRecord(state.line))
  }
}

fn add_record(state: Summary, line: Text) -> Summary {
  case line {
    "" -> Failure(BlankLine(state.line))
    _ -> case Json.decode(line) {
      Success(Value.Object(fields)) -> add_fields(state, check_schema(fields, state.line))
      Success(_) -> Failure(InvalidRecord(state.line))
      Failure(_) -> Failure(InvalidJson(state.line))
    }
  }
}

// Each accepted line is one record. Failures report the line they were read from.
fn add_line(state: Summary, line: Text) -> Summary {
  case state.terminal_seen {
    True -> Failure(RecordAfterOutcome(state.line))
    False -> {
      ..add_record(state, line), line: state.line + 1, records: state.records + 1
    }
  }
}

fn counts_json(counts: Map<Text, Int>) -> Value {
  counts
  |> Map.map_values(Json.int)
  |> Json.object
}

fn render(state: Summary) -> Text {
  Map.from([
    ("schema", Json.text(summary_schema)),
    ("records", Json.int(state.records)),
    ("events", Json.int(state.events)),
    ("operations", counts_json(state.operations)),
    ("dependency_calls", counts_json(state.dependency_calls)),
    ("terminal_outcomes", counts_json(state.terminal_outcomes)),
  ])
  |> Json.object
  |> Json.encode
}

fn finish(state: Summary) -> Text if state.terminal_seen {
  render(state)
}
fn finish(state) {
  Failure(MissingOutcome(state.line))
}

fn summarize(path: Text) -> Text needs {
  files: FileSystem
} {
  files.process_utf8_lines(IO.path(path), empty_summary, add_line)
  |> finish
}

fn report_trace(error: TraceError) -> Void needs {
  console: Console
} {
  console.write_error("trace summary failed")
  Failure(error)
}

pub fn main(arguments: List<Text>) -> Void needs {
  files: FileSystem,
  console: Console,
} {
  case arguments {
    [path] -> case summarize(path) {
      Success(report) -> console.write_line(report)
      Failure(error: TraceError) -> report_trace(error)
      Failure(LineTooLong(_, _) as error) -> {
        console.write_error("trace summary input record is too large")
        Failure(error)
      }
      Failure(error: FileError) -> {
        console.write_error("trace summary file IO failed")
        Failure(error)
      }
      Failure(error: Utf8Error) -> {
        console.write_error("trace summary input is not UTF-8")
        Failure(error)
      }
    }
    _ -> {
      console.write_error(usage)
      Failure(InvalidArgumentCount(List.length(arguments)))
    }
  }
}
